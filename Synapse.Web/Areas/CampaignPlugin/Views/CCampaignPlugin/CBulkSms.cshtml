            function splCount(sval) {
                var regex = /([€|{}\[\]\\~^])/g
                var allFoundCharacters = sval.match(regex);
                if (allFoundCharacters != null) {
                    if (allFoundCharacters.length > 0) {
                        return allFoundCharacters.length * 1
                    }
                } else {
                    return 0;
                }
            }

            function fnShowCount() {

                var obj = $("#QuicksmsorCampaign_Message");
                var sval = (obj.val().trim()); //.trim();
                var svalcountspl = splCount(sval);
                var objCount = $("#txtCharCount");
                var nlen = sval.length;
                objCount.innerHTML = nlen;
                var langidobj = $("#QuicksmsorCampaign_Language");
                var strCredits = 0;
                var nLength;
                var objGSMChars = $("#hdnGSMChars").val();
                var objExGSMCHars = $("#hdnEXGSMChars").val();
                var nreturn = true;
                nLength = sval.length;
                objGSMChars = unescape(objGSMChars);
                objExGSMCHars = unescape(objExGSMCHars);
                for (var i = 0; i < sval.length; i++) {
                    var stvalue = sval[i];
                    if (objGSMChars.indexOf(stvalue) == -1) {
                        if (objExGSMCHars.indexOf(stvalue) != -1) {
                            nLength = nLength + 1;
                        }
                        else {
                            nreturn = false;
                        }
                    }
                }
                nlen = nLength;
                var strNextCountOne = nlen;
                var text = sval.replace(/’/g, "'");
                if (text.match(/[^\u0000-\u007F]/)) {
                    //if (sval.match(/[^\u0000-\u007F]/)) {
                    // if (sval.match(/[\u0000-\u007F]/)) {
                    divider1 = 67;
                    if (nlen <= 70)
                    { strCredits = 1; }
                    else if (nlen > 70 && nlen <= 134)
                    { strCredits = 2; }
                    else {
                        var strTotal = strNextCountOne / divider1;
                        strCredits = Math.ceil(strTotal);
                    }
                    nlangid = 2;
                }
                else {
                    nlen = nlen + svalcountspl;
                    divider1 = 153;
                    if (nlen <= 160)
                    { strCredits = 1; }
                    else if (nlen > 160 && nlen <= 306)
                    { strCredits = 2; }
                    else {
                        var strTotal = strNextCountOne / divider1;
                        strCredits = Math.ceil(strTotal);
                    }
                    nlangid = 1;
                }
                if (nlen == 0) {
                    strCredits = 0;
                }
                $("#txtMSgCount").html(strCredits);
                $("#txtCharCount").html(nlen);
                return false;
            }


        }

        function OnSheetChange(MobileField) {
            var Sheet = $('#QuicksmsorCampaign_SheetID').val() == "0" ? $("#hdnEditSheetID").val() : $('#QuicksmsorCampaign_SheetID').val();//$('#QuicksmsorCampaign_SheetID').val();
            Sheet = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(Sheet), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
            $.ajax({
                type: "POST",
                url: '@Url.Action("OnSheetChange", "CCampaignPlugin")',
                headers: headers,
                data: { Sheet: Sheet },
                datatype: 'application/json',
                success: function (data) {
                    if (data.Invalid) {
                        emsg(data.Message, false);
                    }
                    else {
                        $("#hdnTextReplace").val("");
                        var TextReplace = "";
                        $("#QuicksmsorCampaign_MobileNumberField").html("");
                        $('#QuicksmsorCampaign_MobileNumberField').append($('<option></option>').val(0).html("--Select MobileNo Field--"));
                        var i = 1;
                        $.each(data.FileRecord, function (key, val) {
                            $('#QuicksmsorCampaign_MobileNumberField').append($('<option></option>').val(i).html(key));
                            TextReplace += key + "::" + val + "||";
                            i++;
                        });
                        $("#hdnTextReplace").val(TextReplace);
                        $("#QuicksmsorCampaign_MobileNumberField option").filter(function () { return ($(this).text() == MobileField) }).attr('selected', true);

                    }
                },
                error: function (xhr, status) {
                    $("#QuicksmsorCampaign_ExcelFile").val("");
                    $(".filename").text("No file Selected");
                    $("#hdnFilePath").val(0);
                    $("#DeleteFile").attr("disabled", true);
                    errorMessage("@lz.ExceptionOccured");
                    $("html,body").animate({ scrollTop: 0 }, 200);
                }
            });
        }
        function OnSetDropDowns() {
            $(".uploader").removeAttr("title");
            $(".filename").removeAttr("style");
            $("#QuicksmsorCampaign_SheetID,#QuicksmsorCampaign_MobileNumberField").html('');
            $('#QuicksmsorCampaign_SheetID').append($('<option></option>').val(0).html("--Select Sheet--"));
            $('#QuicksmsorCampaign_MobileNumberField').append($('<option></option>').val(0).html("--Select MobileNo Field--"));
            $(".filename").text("No file Selected");
            $("#QuicksmsorCampaign_ExcelFile").val("");
            $("#DeleteFile").attr("disabled", true);
            $("#hdnFilePath").val(0);
        }


    </script>

    <script type="text/javascript">

        String.prototype.replaceAll = function (find, replace) {
            var str = this;
            return str.replace(new RegExp(find.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&'), 'g'), replace);
        };

        $('a[data-toggle="tooltip"]').tooltip({
            animated: 'fade',
            placement: 'bottom',
            template: '<div class="tooltip" style="border: 1px solid #cccccc;background: #ffffff; width: 400px; padding: 3px;white-space: nowrap"><div class="tooltip-inner" style="background: #ffffff; width:400px; color:#333333;white-space: nowrap"></div></div>',
            html: true
        });

        function Rdoonchange(value, id) {
            $('input:hidden[id=' + id + ']').val($(value).attr("datalang"))
            smscount();
        }
        $('.enlng').on('change', function () {
            $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
        });
        $('.arlng').on('change', function () {
            $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'rtl').attr('lang', 'ar');
        });

        //schedule later function
        $('#QuicksmsorCampaign_ScheduleType,#QuicksmsorCampaign_ScheduleStartDate,#QuicksmsorCampaign_ScheduleStartTime,#QuicksmsorCampaign_ScheduleStartMinutes').change(function () {
            LoadSCHDetails();
        });

        function LoadSCHDetails() {
            $('#schDetails').html('');
            if ($('.ScheduleLater input, .ScheduleLater select').val() != null || $('.ScheduleLater input,.ScheduleLater select').val() != "0") {
                $('#schDetails').show();
                var schType = $('#QuicksmsorCampaign_ScheduleType option:selected');
                var hours = $('#QuicksmsorCampaign_ScheduleStartTime').val();
                if (parseInt(hours) <= 9) { hours = "0" + hours; }
                var minutes = $('#QuicksmsorCampaign_ScheduleStartMinutes').val();
                if (parseInt(minutes) <= 9) { minutes = "0" + minutes; }
                $('#schDetails').html('<b>Schedule:</b> '
                    + $(schType).text() + " , "
                    + $('#QuicksmsorCampaign_ScheduleStartDate').val() + "  "
                    + hours + ":"
                    + minutes + ":"
                    + "00"
                );

            }
            else {
                $('#schDetails').hide();
            }
        }

        $(".schlater").click(function () {
            $('.ScheduleLater').show();
            $(this).attr('checked', 'checked');
            $('.sendnow').removeAttr('checked', 'checked');          
            $('#QuicksmsorCampaign_ScheduleStartDate').attr('rc', 'y');

        });
        $(".sendnow").click(function () {
            $('.ScheduleLater').hide();
            $(this).attr('checked', 'checked');
            $('.schlater').removeAttr('checked', 'checked');

            setTimeout(function () {
                $('#QuicksmsorCampaign_ScheduleStartDate').removeAttr('rc', 'n');
                removeerrorstylectrolfocus('#QuicksmsorCampaign_ScheduleStartDate');
            }, 2);
        });
        //contact groups function
        var fnUpdateCount = function () {
            var ContactGroup = $(".scrollarea input[type=checkbox]:checked").length;
            console.log(ContactGroup, $("span.counter"))
            if (ContactGroup > 0) {
                $('span.counter').fadeIn(1000);
                $('span.counter').html('Selected Groups: ' + ContactGroup + '<span onclick="rmvGrp()" class="icon12 fa fa-remove" style="color:#7f0000; cursor:pointer;"></span>');
            } else {
                $("span.counter").html('');
            }
        };
        $(".scrollarea").on("change", function () {
            fnUpdateCount();
        });
        $('.scrollarea').change(function () {
            var checkthis = $(this);
            // var checkboxes = $(".scrollarea input:checkbox");

            if (checkthis.is(':checked')) {
                checkthis.prop('checked', true);
            } else {
                checkthis.prop('checked', false);
            }

            fnUpdateCount();
        });
        function rmvGrp() {
            $('.scrollarea input[type=checkbox]').removeAttr('checked');
            $('span.counter').fadeOut(1000);
        }
        $("#QuicksmsorCampaign_ScheduleStartDate").datepicker({
            format: 'D M dd yyyy',
            autoclose: true,
            startDate: '0'
        });

        /* Popover */

        $('.maininfo').popover({
            html: true,
            content: function () {
                return $('#myPopoverContent').html();
            }
        });


        $(document).on('click', function (e) {
            $('[data-toggle="popover"],[data-original-title]').each(function () {
                //the 'is' for buttons that trigger popups
                //the 'has' for icons within a button that triggers a popup
                if (!$(this).is(e.target) && $(this).has(e.target).length === 0 && $('.popover').has(e.target).length === 0) {
                    (($(this).popover('hide').data('bs.popover') || {}).inState || {}).click = false  // fix for BS 3.3.6
                }
            });
        });

        /* Popover */

        $("#BackCampaign").click(function () {
            $("#RejectNote").hide();
            $("#ApproveBulk,#RejectBulk").show();

        });

        function AddError(item, errormsg) {
            //debugger;
            $(item).parent().find(".error").remove();
            $(item).parent().append('<div class="error" style="color: red; height:10px !important;">' + errormsg + ' </div>');
        }

        function closepover() {
            $('.popover').toggleClass('in').remove();
        }


        $("#RejectBulk").click(function () {
            //debugger;
            var rejectreason = $("#QuicksmsorCampaign_RejectNote").val();
            var Status = false;
            if (rejectreason != "") {
                Status = true;
            }
            if (Status == true) {
                $("#QuicksmsorCampaign_RejectNote").removeAttr('style', 'border: 1px solid red !important');
                var QSMSID = $("#hdnCampID").val();
                var StageIDs = $("#hdnStageIDs").val();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("ApproveOrRejectQSMS", "CCampaignPlugin")',
                    headers: headers,
                    data: { QSMSID: QSMSID, Status: 2, CurrentStatus: 3, Rejectreason: rejectreason, MbcID: 1, Stage: StageIDs, ModuleType: 1 },
                    datatype: 'html',
                    success: function (data) {
                        $("#hdnCampID").val(0);
                        $("#hdnStageIDs").val("");
                        if (data == 7) {
                            successMessage('Campaign rejected successfully.');
                            $("html, body").animate({ scrollTop: 0 }, 600);
                            setTimeout(function () {
                                window.location.reload(false);
                            }, 2000);
                            return false
                        }
                        if (data == 6) {
                            errorMessage("Campaign Time Exceeded");
                            $("html body").animate({ scrollTop: 0 });
                            setTimeout(function () {
                                window.location.reload(false);
                            }, 2000);
                            return false
                        }
                        else {
                            errorMessage("Send SMS Service may not be up and running.Messages will be sent once the service starts.");
                            $("html body").animate({ scrollTop: 0 });
                            setTimeout(function () {
                                window.location.reload(false);
                            }, 2000);
                        }
                    },
                    error: function (xhr, status) {
                        $("#hdnCampID").val(0);
                        $("#hdnStageIDs").val("");
                        errorMessage('Exception Occured');
                        $("html, body").animate({ scrollTop: 0 }, 600);
                        setTimeout(function () {
                            window.location.reload(false);
                        }, 2000);
                        return false
                    }
                })
            }
        });
    </script>
}
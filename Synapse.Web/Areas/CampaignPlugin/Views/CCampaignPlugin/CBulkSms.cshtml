                    emsg("@lz.Uploadfilecontainsdotsinfilename", false);
                    $("#QuicksmsorCampaign_ExcelFile").val("");
                    $(".filename").text("");
                    return false;
                }
                var ext = fileName.match(/\.([^\.]+)$/)[1].toLowerCase();

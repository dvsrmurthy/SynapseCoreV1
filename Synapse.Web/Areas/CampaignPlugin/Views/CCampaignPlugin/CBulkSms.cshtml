    <script type="text/javascript">
        var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
        var headers = {};
        headers['__RequestVerificationToken'] = antiForgeryToken;

        function sample(value, act) {
            $("#SelectSheet").hide();
            $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
            if (act != (null || undefined) && act == 'Edit') {
                internalPost("@Url.Action("OnEdit", "PhoneBookPlugin")", { id: value }, 'CheckerUpdation', 'group_');
            }
            else {
                clearparent('CheckerUpdation', 'group_');
            }
        }

        function CampEvents(CampID, Stages, cntrl) {
            var selCamps = $("#GridID").find("input[type=checkbox]:checked").length;
            if (selCamps == 1) {
                if ($(cntrl).is(":checked")) {
                    if (Stages == "" || Stages == null) {
                        $("#Pause,#Resume,#Suspend").hide();
                        $("#Deactivate").show();
                    }
                    else {
                        $("#Deactivate").hide();
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("GetStageCounts", "CampaignPlugin")',
                            headers: headers,
                            data: { CampID: CampID, Stages: Stages },
                            datatype: 'application/json',
                            success: function (data) {
                                if (data == "ResumeEnable") {
                                    $("#Resume,#Suspend").show();
                                    $("#Pause").hide();
                                }
                                else if (data == "PauseEnable") {
                                    $("#Pause,#Suspend").show();
                                    $("#Resume").hide();
                                }
                                else if (data == "DisableRow") {
                                    $("#Deactivate,#Pause,#Resume,#Suspend").hide();
                                    errorMessage('Already Campaign Completed, You can not do any operation with the selected campaign');
                                    $("html, body").animate({ scrollTop: 0 }, 600);
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                }
                            },
                            error: function (xhr, status) {
                                errorMessage('Exception Occured');
                                $("html, body").animate({ scrollTop: 0 }, 600);
                                setTimeout(function () {
                                    window.location.reload(false);
                                }, 2000);
                            }
                        });
                    }
                }
            }
            else if (selCamps > 1) {
                $("#Pause,#Resume,#Suspend,#Deactivate").show();
                $("#GridID").find("input[type=checkbox]").removeAttr("checked");
                errorMessage("Please select one campign only.");
                $("html, body").animate({ scrollTop: 0 }, 600);
            }
            else if (selCamps == 0) {
                $("#Pause,#Resume,#Suspend,#Deactivate").show();
            }
        }
        function SetCampaignEvents(cntrl) {
            var selCamps = $("#GridID").find("input[type=checkbox]:checked").length;
            if (selCamps == 1) {
                var Status = 1;
                if (cntrl == "Deactivate") { Status = 0; }
                else if (cntrl == "Pause") { Status = 8; }
                else if (cntrl == "Resume") { Status = 4; }
                else if (cntrl == "Suspend") { Status = 12; }
                var CampID = $("#GridID").find("input[type=checkbox]:checked").attr("data-id").split('||')[0];
                var StageIDs = $("#GridID").find("input[type=checkbox]:checked").attr("data-id").split('||')[1];
                if (StageIDs == "" || StageIDs == null) { StageIDs = 0 }
                if (CampID != 0 || CampID != "") {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("CampaignEvents", "CampaignPlugin")',
                        headers: headers,
                        data: { CampID: CampID, StageIDs: StageIDs, Status: Status, cmd: "Deactivate" },
                        datatype: 'application/json',
                        success: function (d) {
                            if (d != (null || undefined)) {
                                if (d == 2) {
                                    successMessage("Campaign Deactivated Successfully.");
                                    $("html body").animate({ scrollTop: 0 });
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                }
                                else if (d == 8) {
                                    successMessage("Campaign Paused Successfully.");
                                    $("html body").animate({ scrollTop: 0 });
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                }
                                else if (d == 0) {
                                    successMessage("Campaign Resumed Successfully.");
                                    $("html body").animate({ scrollTop: 0 });
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                }
                                else if (d == 12) {
                                    successMessage("Campaign Suspended Successfully.");
                                    $("html body").animate({ scrollTop: 0 });
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                }
                            }
                        },
                        error: function (xhr, status) {
                            errorMessage('Exception Occured');
                            $("html, body").animate({ scrollTop: 0 }, 600);
                        }
                    });
                }
            }
            else {
                errorMessage("Please select at least one campign.");
                $("html, body").animate({ scrollTop: 0 }, 600);
            }
        }

            function OnCheckTemplate(cntrl) {
                $('#QuicksmsorCampaign_TemplateID').html("").append($('<option></option>').val(0).html("--Select Template--"));
                if ($(cntrl).is(":checked")) {
                    removeerrorstylectrolfocus("#QuicksmsorCampaign_Message");
                    $("#TemplateDiv").show();
                    $("#QuicksmsorCampaign_Message").attr("disabled", true);
                    $('.english,.arabic').prop("disabled", true);
                    var CampType = 1;
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("LoadTemplates", "CCampaignPlugin")',
                        headers: headers,
                        data: { CampType: CampType },
                        datatype: 'application/json',
                        success: function (data) {
                            $('#QuicksmsorCampaign_TemplateID').html("");
                            $('#QuicksmsorCampaign_TemplateID').append($('<option></option>').val(0).html("--Select Template--"));
                            $.each(data, function (key, val) {
                                $('#QuicksmsorCampaign_TemplateID').append(
                                   // $('<option></option>').val(val.ID + "$VMHDC$" + val.LANGUAGEID + "$VMHDC$" + val.TEXT).html(val.NAME));
                                $('<option></option>').attr({ 'data-lang': val.LANGUAGEID, 'data-msg': val.TEXT }).val(val.ID).html(val.NAME));
                            });
                        },
                        error: function (xhr, status) {
                            errorMessage('@lz.ExceptionOccured');
                            $("html, body").animate({ scrollTop: 0 }, 600);
                        }
                    });
                } else {
                    $("#TemplateDiv").hide();
                    $("#QuicksmsorCampaign_Message").attr("disabled", false);
                    //$("#QuicksmsorCampaign_Message").val("");
                    //$("#QuicksmsorCampaign_PreviewMessage").val("");
                    $('.english').prop("checked", true);
                    $('.english,.arabic').prop("disabled", false);
                    $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
                    $('#QuicksmsorCampaign_Language').prop('disabled', false);
                }
            }

            function OnChangeTemplate(cntrl) {
                var arabiclan = /[\u0621-\u064A]/;
                if ($(cntrl).val() != 0) {
                    removeerrorstylectrolfocus('#QuicksmsorCampaign_Message');
                    //var TempLang = $('#QuicksmsorCampaign_TemplateID').val().split('$VMHDC$')[1];
                    //var TempText = $('#QuicksmsorCampaign_TemplateID').val().split('$VMHDC$')[2];
                    var TempLang = $('#QuicksmsorCampaign_TemplateID  option:selected').attr('data-lang');
                    var TempText = $('#QuicksmsorCampaign_TemplateID  option:selected').attr('data-msg');
                    $("#QuicksmsorCampaign_Message").val(TempText);
                    $("#QuicksmsorCampaign_PreviewMessage").val(TempText);
                    if (TempLang == 1) {
                        $('.english').attr("checked", true);
                        $('.english').prop("checked", true);
                        $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
                    } else {
                        $('.arabic').attr("checked", true);
                        $('.arabic').prop("checked", true);

            function OnViewClick(QSMSName, Sender, Lang, Message, CreditsUsed, TotalCredits, Dlr, AddedDate, Status, RecipentID, ValidCount, ScheduleDate, ActualFileName, GroupIds, Edit) {
                var GrpName = "";
                //var e_msg = Message;
                var e_msg = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(Message.replaceAll("^^", '"').replaceAll("^", "ÞÞ")), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                $.each(GroupIds.split(','), function (i, item) {
                    var Checkboxes = $("#GroupsDiv").find("input[type=checkbox]");
                    $.each(Checkboxes, function (i, CB) {
                        if ($(CB).attr("id") == item) {
                            GrpName += $(CB).attr("data-id") + ",";
                        }
                    });
                });
                var QSMSName = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(QSMSName), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var Sender = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(Sender), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var Lang = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(Lang), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var CreditsUsed = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(CreditsUsed), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var TotalCredits = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(TotalCredits), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var Dlr = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(Dlr), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var AddedDate = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(AddedDate), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var Status = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(Status), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var ValidCount = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(ValidCount), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                // var RecipentID = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(RecipentID), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var GrpName = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(GrpName) == "" ? "QSMS" : GrpName, key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var ScheduleDate = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(ScheduleDate) == "" ? "QSMS" : ScheduleDate, key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var ActualFileName = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(ActualFileName) == "" ? "QSMS" : ActualFileName, key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var strRecipentID = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(RecipentID), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();


                $.ajax({
                    type: "POST",
                    url: '@Url.Action("OnView", "CCampaignPlugin")',
                    headers: headers,
                    data: { QSMSName: QSMSName, Sender: Sender, Lang: Lang, Message: e_msg, CreditsUsed: CreditsUsed, TotalCredits: TotalCredits, Dlr: Dlr, AddedDate: AddedDate, Status: Status, strRecipentID: strRecipentID, GrpName: GrpName, ValidCount: ValidCount, ScheduleDate: ScheduleDate, ActualFileName: ActualFileName, cmd: "_BulkSMSView" },
                    datatype: 'application/json',
                    success: function (d) {
                        if (d != (null || undefined)) {
                            if (d.Invaid) {
                                emsg(d.Message, false);
                                return false;
                            }
                            else {
                                $("#PartialResult").html('');
                                $("#PartialResult").html(d.PartialResult);
                            }
                        }
                    },
                    error: function (xhr, error, status) {
                        var err = xhr;
                    }
                });
            }


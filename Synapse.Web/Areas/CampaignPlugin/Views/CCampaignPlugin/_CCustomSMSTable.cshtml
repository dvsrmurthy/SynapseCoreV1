@using Synapse.Web.CampaignPlugin.Models
@using Core.Models.Enums;
@model List<QuickSMSOrCampaign>

<div class="table-responsive">
    <table class="table table-striped table-bordered dataTable gridtable">
        <thead>
            <tr>
                <th></th>
                <th>Campaign Name</th>
                <th>SenderID</th>
                <th>Language</th>
                <th>Valid Recipients</th>
                <th>CreditsPerMsg</th>
                <th>ScheduleDate</th>
                <th>Status</th>
                @if (Model.FirstOrDefault() != null && Model.FirstOrDefault().CustID == 1)
                {
                    <th>Functional Status</th>
                }
                else if (Model.FirstOrDefault() != null && Model.FirstOrDefault().IsCheckerRequired)
                {
                    <th>Functional Status</th>
                }
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                var id = item.ActualFileName;
                var isRowEnable = true;
                if (!string.IsNullOrWhiteSpace(item.ImportFileName))
                {
                    var ImportFilename = item.ImportFileName.Replace("^", "\\");
                    var localDirLen = System.Configuration.ConfigurationManager.AppSettings["LocalDIR"];
                    var fileName = string.Join("\\", ImportFilename.Split(new string[] { "\\" }, StringSplitOptions.None).Skip(Convert.ToInt32(localDirLen)).ToList());
                    var fileClientName = System.IO.Path.GetFileNameWithoutExtension(fileName).Replace("&", "") + "_client.csv";
                    var basePath = System.Configuration.ConfigurationManager.AppSettings["tempPathVirtualPath"] + "\\" + System.IO.Path.GetDirectoryName(fileName) + "\\" + fileClientName;
                    <tr>
                        <td>
                            @switch (@item.RecipientsType)
                            {
                                case FILETYPE.NOTEPAD:
                                    <a href="@basePath" class="FileDownload">
                                        <span class="fa fa-file-text-o fa-1x text-primary"></span>
                                    </a>
                                    break;
                                case FILETYPE.EXCEL:
                                    <a href="@basePath" class="FileDownload">
                                        <span class="fa fa-file-excel-o fa-1x text-success"></span>
                                    </a>
                                    break;
                                case FILETYPE.GROUPS:
                                    <span class="fa fa-address-book-o fa-1x text-purple"></span>
                                    break;
                                case FILETYPE.DB:
                                    <span class="fa fa-database fa-1x"></span>
                                    break;
                            }

                        </td>
                        <td>
                            <a href="#" onclick="javascript: OnViewClick('@item.CampaignNameorRecipient.Replace("^", "ÞÞ").Replace("\\", "^")','@item.Sender','@item.Language','@item.Message.Replace("\"", "^^").Replace("\\", "Ø")','@item.CreditsUsed','@item.TotalCAMPCredits','@item.Dlr','@item.AddedDate','@item.Status','@item.RecipentID','@item.ValidCount','@item.ScheduleDate','@item.ImportFileName','@item.GroupIds','Edit')" id="DisplayID" data-target="#demo-lg-modal" data-toggle="modal" title="View">
                                @item.CampaignNameorRecipient
                            </a>
                        </td>

                        <td>@item.Sender</td>
                        <td>@item.Language</td>
                        <td>@item.ValidCount</td>
                        <td>@item.CreditsUsed</td>
                        <td>@item.ScheduleDate</td>
                        <td>@item.Status</td>
                        @if (item.CustID != null && item.CustID == 1)
                        {
                            if (item.Status == "Suspended")
                            {
                                <td>
                                    @switch (@item.CurrentStatus)
                                    {
                                        case Cstatus.Pending:
                                            <span class='label label-table label-warning'>Pending</span>
                                            break;
                                    }
                                </td>
                            }
                            else
                            {
                                <td>
                                    @switch (@item.CurrentStatus)
                                    {
                                        @*case Cstatus.Approve:
                                            @Html.Raw("<a class='label label-table label-success'>Approved</a>")
                                            break;*@
                                        case Cstatus.Pending:
                                            <a href="javascript:OnEdit('@item.QuickOrCampaignId','@item.CampaignNameorRecipient.Replace("^", "ÞÞ").Replace("\\", "Ø").Replace("%", "qzzzq")','@item.SenderId','@item.LanguageId','@item.Message.Replace("\"", "^^").Replace("\\", "Ø").Replace("%", "qzzzq")','@item.Dlr','@((item.CampTypeID) ? "2" : "1")','@item.MobileField','@item.ImportFileName','@item.RecipentID','@item.GroupIds','@item.ActualFileName','@item.Sheet','@item.ScheduledType','@item.ScheduleDate','@((item.AllowDups) ? "1" : "0")','@item.Status','@item.RuleId','@item.Remarks','Edit')"
                                               @*<a href='javascript: OnEdit("@item.QuickOrCampaignId","@item.CampaignNameorRecipient","@item.SenderId","@item.LanguageId","@item.Message","@item.Dlr","@item.CampTypeID","@item.MobileField","@item.ImportFileName","@item.RecipentID","@item.GroupIds","@item.ActualFileName","@item.Sheet","@item.ScheduledType","@item.ScheduleDate","@((item.AllowDups)?"1":"0")","@item.Stage","@item.intStatus","Edit")' class="">*@
                                               class="label label-table label-warning CheckerPendingBtn" alt="Pending" title="Pending">
                                                Pending
                                            </a>

                                            break;
                                        case Cstatus.TimeExceeded:
                                            @Html.Raw("<span class='label label-table label-info'>TimeExceeded</span>")
                                            break;
                                            @*case Cstatus.Rejected:
                                            @Html.Raw("<span class='label label-table label-danger'>Rejected</span>")
                                                break;*@
                                    }

                                </td>
                            }
                        }

                        else if (item.IsCheckerRequired)
                        {
                            if (item.Status == "Suspended")
                            {
                                <td>
                                    @switch (@item.CurrentStatus)
                                    {
                                        case Cstatus.Pending:
                                            <span class='label label-table label-warning'>Pending</span>
                                            break;
                                    }
                                </td>
                            }
                            else
                            {
                                <td>
                                    @switch (@item.CurrentStatus)
                                    {
                                        @*case Cstatus.Approve:
                                                @Html.Raw("<a class='label label-table label-success'>Approved</a>")
                                                break;*@
                                        case Cstatus.Pending:
                                            <a href="javascript:OnEdit('@item.QuickOrCampaignId','@item.CampaignNameorRecipient.Replace("^", "ÞÞ").Replace("\\", "Ø").Replace("%", "qzzzq")','@item.SenderId','@item.LanguageId','@item.Message.Replace("\"", "^^").Replace("\\", "Ø").Replace("%", "qzzzq")','@item.Dlr','@((item.CampTypeID) ? "2" : "1")','@item.MobileField','@item.ImportFileName','@item.RecipentID','@item.GroupIds','@item.ActualFileName','@item.Sheet','@item.ScheduledType','@item.ScheduleDate','@((item.AllowDups) ? "1" : "0")','@item.Status','@item.RuleId','@item.Remarks','Edit')"
                                               @*<a href='javascript: OnEdit("@item.QuickOrCampaignId","@item.CampaignNameorRecipient","@item.SenderId","@item.LanguageId","@item.Message","@item.Dlr","@item.CampTypeID","@item.MobileField","@item.ImportFileName","@item.RecipentID","@item.GroupIds","@item.ActualFileName","@item.Sheet","@item.ScheduledType","@item.ScheduleDate","@((item.AllowDups)?"1":"0")","@item.Stage","@item.intStatus","Edit")' class="">*@
                                               class="label label-table label-warning CheckerPendingBtn" alt="Pending" title="Pending">
                                                Pending
                                            </a>

                                            break;
                                        case Cstatus.TimeExceeded:
                                            @Html.Raw("<span class='label label-table label-info'>TimeExceeded</span>")
                                            break;
                                            @*case Cstatus.Rejected:
                                                @Html.Raw("<span class='label label-table label-danger'>Rejected</span>")
                                                    break;*@
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

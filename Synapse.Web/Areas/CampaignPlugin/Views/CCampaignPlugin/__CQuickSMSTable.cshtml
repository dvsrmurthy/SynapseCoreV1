@using Synapse.Web.CampaignPlugin.Models
@using Core.Models.Enums;
@model List<QuickSMSOrCampaign>

<div class="table-responsive">
    <table class="table table-striped table-bordered dataTable gridtable">
        <thead>
            <tr>
                <th>Recipient(s)</th>
                @*<th>SMS Type</th>*@
                <th>Message</th>
                <th>SenderID</th>
                <th>Language</th>
                @*<th>Valid Recipients</th>*@
                <th>Credits</th>
                <th>SendDate</th>
                <th>Status</th>
                <th>Functional Status</th>

                @*<th>Functional Status</th>*@
                @*<th>Action</th>*@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (@item.CampaignNameorRecipient != null)
                        {
                            <a href="javascript:void(0)" onclick="javascript: OnViewClick('@item.CampaignNameorRecipient','@item.Sender','@item.Language','@item.Message','@item.CreditsUsed','@item.TotalQSMSCredits','@item.Dlr','@item.AddedDate','@item.Status','Edit')" id="DisplayID" data-target="#demo-lg-modal" data-toggle="modal" title="View">
                                @if (@item.CampaignNameorRecipient.Length >= 15)
                                {
                                    @item.CampaignNameorRecipient.Substring(0, 15) @Html.Raw("...")
                                    ; ;
                                }
                                else
                                {
                                    @item.CampaignNameorRecipient
                                }
                                @*@item.CampaignNameorRecipient.Substring(0, ((item.CampaignNameorRecipient.Length - 1 <= 15) ? item.CampaignNameorRecipient.Length - 1 : 15))...*@
                            </a>
                        }
                    </td>
                    @*<td>@item.Message.Substring(0, ((item.Message.Length - 1 <= 15) ? item.Message.Length : 15))...</td>*@
                    <td>
                        @if (@item.Message.Length >= 15)
                        {
                            @item.Message.Substring(0, 15) @Html.Raw("...")
                            ; ;
                        }
                        else
                        {
                            @item.Message
                        }
                    </td>
                    <td>@item.Sender</td>
                    <td>@item.Language</td>
                    <td>@item.CreditsUsed</td>
                    <td>@item.AddedDate</td> @*.Substring(0, 16)*@
                    <td>@item.Status</td>

                    <td>
                        <a href="javascript: OnEdit('@item.QuickOrCampaignId','@item.CampaignNameorRecipient','@item.SenderId','@item.LanguageId','@item.Message','@item.Dlr','@item.Stage','Edit')" class='label label-table label-warning' alt="Pending" title="Pending">Pending</a>

                        @*@switch (@item.CurrentStatus)
                            {
                                case Cstatus.Approve:
                                    @Html.Raw("<a class='btn btn-sm btn-success'>A</a>")
                                    break;
                                case Cstatus.Pending:
                                @Html.Raw("<a class='btn btn-sm btn-warning'>P</a>")
                                    break;
                                case Cstatus.Rejected:
                                @Html.Raw("<span class='btn btn-sm btn-danger'>R</span>")
                                    break;
                            }*@

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

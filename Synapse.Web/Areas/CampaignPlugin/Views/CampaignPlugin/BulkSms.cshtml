        function SetCampaignActivities(campId, stagId, status, cm, schtype) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("CampaignEvents", "CampaignPlugin")',
                headers: headers,
                data: { CampID: campId, StageIDs: stagId, Status: status, cmd: cm },
                datatype: 'application/json',
                success: function (d) {
                    if (d !== (null || undefined)) {
                        switch (d) {
                            case 2:
                                $("html body").animate({ scrollTop: 0 });
                                successMessage("@lz.CampaignDeactivatedSuccessfully", true);
                                hiddenvalues();
                                setTimeout(function () {
                                    location.reload();
                                }, 2000);
                                break;
                            case 8:
                                $("html body").animate({ scrollTop: 0 });
                                successMessage("@lz.CampaignPausedSuccessfully", true);
                                hiddenvalues();
                                setTimeout(function () {
                                    location.reload();
                                }, 2000);
                                break;
                            case 0:
                                $("html body").animate({ scrollTop: 0 });
                                successMessage("@lz.CampaignSuspendedSuccessfully", true);
                                hiddenvalues();
                                setTimeout(function () {
                                    location.reload();
                                }, 2000);
                                break;
                            case 4:
                                $("html body").animate({ scrollTop: 0 });
                                successMessage("@lz.CampaignSuspendedSuccessfully", true);
                                hiddenvalues();
                                setTimeout(function () {
                                    location.reload();
                                }, 2000);
                                break;
                        }
                    }
                },
                error: function (xhr, status) {
                    errorMessage('@lz.ExceptionOccured');
                    $("html, body").animate({ scrollTop: 0 }, 600);
                }
            });
        }


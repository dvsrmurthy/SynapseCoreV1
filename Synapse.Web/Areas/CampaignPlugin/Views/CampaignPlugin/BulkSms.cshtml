    <script type="text/javascript">
        var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
        var headers = {};
        headers['__RequestVerificationToken'] = antiForgeryToken;

        function sample(value, act) {
            $("#SelectSheet").hide();
            $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
            if (act != (null || undefined) && act == 'Edit') {
                internalPost("@Url.Action("OnEdit", "PhoneBookPlugin")", { id: value }, 'ADDForm', 'group_');
            } else {
                clearparent('ADDForm', 'group_');
                setTimeout(function () { $("#QuicksmsorCampaign_CampaignNameorRecipient").focus(); }, 1000);
            }
        }

        function CampEvents(CampID, Stages, cntrl) {
            var selCamps = $("#GridID").find("input[type=checkbox]:checked").length;
            if (selCamps == 1) {
                if ($(cntrl).is(":checked")) {
                    if (Stages == "" || Stages == null) {
                        $("#Pause,#Resume,#Suspend").hide();
                        $("#Deactivate").show();
                    } else {
                        $("#Deactivate").hide();
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("GetStageCounts", "CampaignPlugin")',
                            headers: headers,
                            data: { CampID: CampID, Stages: Stages },
                            datatype: 'application/json',
                            success: function (data) {
                                if (data == "ResumeEnable") {
                                    $("#Resume,#Suspend").show();
                                    $("#Pause").hide();
                                } else if (data == "PauseEnable") {
                                    $("#Pause,#Suspend").show();
                                    $("#Resume").hide();
                                } else if (data == "DisableRow") {
                                    $("#Deactivate,#Pause,#Resume,#Suspend").hide();
                                    errorMessage("@lz.Youcantdoanyoperationwiththeselectedcampaign");
                                    $("html, body").animate({ scrollTop: 0 }, 600);
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                }
                            },
                            error: function (xhr, status) {
                                errorMessage('@lz.ExceptionOccured');
                                $("html, body").animate({ scrollTop: 0 }, 600);
                                //setTimeout(function () {
                                //    window.location.reload(false);
                                //}, 2000);
                            }
                        });
                    }
                }
            } else if (selCamps > 1) {
                $("#Pause,#Resume,#Suspend,#Deactivate").show();
                $("#GridID").find("input[type=checkbox]").removeAttr("checked");
                errorMessage("Please select one campign only.");
                $("html, body").animate({ scrollTop: 0 }, 600);
            } else if (selCamps == 0) {
                $("#Pause,#Resume,#Suspend,#Deactivate").show();
            }
        }

        function SetCampaignEvents(cntrl) {
            var selCamps = $("#GridID").find("input[type=checkbox]:checked").length;
            if (selCamps == 1) {
                var Status = 1;
                if (cntrl == "Deactivate") {
                    Status = 0;
                } else if (cntrl == "Pause") {
                    Status = 3;
                } else if (cntrl == "Resume") {
                    Status = 12;
                } else if (cntrl == "Suspend") {
                    Status = 4;
                }
                var CampID = $("#GridID").find("input[type=checkbox]:checked").attr("data-id").split('||')[0];
                var StageIDs = $("#GridID").find("input[type=checkbox]:checked").attr("data-id").split('||')[1];
                if (StageIDs == "" || StageIDs == null) {
                    StageIDs = 0
                }
                if (CampID != 0 || CampID != "") {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("CampaignEvents", "CampaignPlugin")',
                        headers: headers,
                        data: { CampID: CampID, StageIDs: StageIDs, Status: Status, cmd: "Deactivate" },
                        datatype: 'application/json',
                        success: function (d) {
                            if (d != (null || undefined)) {
                                if (d == 2) {
                                    successMessage("@lz.CampaignDeactivatedSuccessfully");
                                    $("html body").animate({ scrollTop: 0 });
                                    hiddenvalues();
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                } else if (d == 8) {
                                    successMessage("@lz.CampaignPausedSuccessfully");
                                    $("html body").animate({ scrollTop: 0 });
                                    hiddenvalues();
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                } else if (d == 0) {
                                    successMessage("@lz.CampaignResumedSuccessfully");
                                    $("html body").animate({ scrollTop: 0 });
                                    hiddenvalues();
                                    setTimeout(function () {
                                        window.location.reload(false);
                                    }, 2000);
                                } else if (d == 4) {
                                    successMessage("@lz.CampaignSuspendedSuccessfully");
                                    $("html body").animate({ scrollTop: 0 });
                                    hiddenvalues();
                                    setTimeout(function () {
                                        location.reload();

                    $(".filename").text("");
                    return false;
                }
                var ext = fileName.match(/\.([^\.]+)$/)[1].toLowerCase();
                fileName = fileName.split('\\').pop();
                switch (ext) {
                    case 'xls':
                    case 'xlsx':
                    case 'csv':
                    case 'txt':
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            var contents = e.target.result;

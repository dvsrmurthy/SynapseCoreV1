                                            errorMessage('@lz.InvalidFileFormat', false);
                                            $('.filename').html("No file Selected");
                                            $("#QuicksmsorCampaign_ExcelFile").val('');
                                            $("html,body").animate({ scrollTop: 0 }, 200);
                                            return false;
                                        }
                                        if (d == "Special Characters") {
                                            errorMessage('File name contains invalid characters(Accepts a – z , A – Z , 0-9 , - , _ , space characters only)', false);
                                            $('.filename').html("No file Selected");
                                            $("#QuicksmsorCampaign_ExcelFile").val('');
                                            $("html,body").animate({ scrollTop: 0 }, 200);
                                            return false;
                                        }
                                        if (d == "Invalid File") {
                                            errorMessage('@lz.InvalidFileFormat', false);
                                            $("#QuicksmsorCampaign_ExcelFile").val('');
                                            // $('.warningmessage').html('Invalid file format').addClass('alert alert-danger').delay(4000).fadeOut();
                                            $('.filename').html("No file Selected");
                                            $("html,body").animate({ scrollTop: 0 }, 200);
                                            return false;
                                        }

                                        if (d == "File should contain header information") {
                                            errorMessage('@lz.UploadFileshouldcontainheaderinformation', false);
                                            // $('.warningmessage').html('Invalid file format').addClass('alert alert-danger').delay(4000).fadeOut();
                                            $('.filename').html("No file Selected");
                                            $("#QuicksmsorCampaign_ExcelFile").val('');
                                            $("html,body").animate({ scrollTop: 0 }, 200);

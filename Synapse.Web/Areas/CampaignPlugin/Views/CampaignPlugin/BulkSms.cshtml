            function OnEdit(QSMSID, CampName, SenderID,SenderName, LangID, Message, DLR, CampaignTypeID, MobileField, ImportFileName, RecipentID, GroupIds, ActualFileName, Sheet, ScheduledType, ScheduleDate, AllowDups, Status, RuleId, Remarks, edit) {
            $("#hdnGroupFilePath").val("");
            $("#hdnGroupFilePath").val(ActualFileName);
            var arabiclan = /[\u0621-\u064A]/;
            var unicodelan = /[\u0000-\u007F]/;
            $('#QuicksmsorCampaign_ExcelFile').val("");
            $("#UploadExcelFile,#UploadTextFile,#UploadGroupFile").hide();
            $("#UploadGroupFile").find("input[type=checkbox]").removeAttr("checked").prop("checked", false);
            $('#QuicksmsorCampaign_Template').removeAttr('checked', 'checked').prop('checked', false);
            OnCheckTemplate($('#QuicksmsorCampaign_Template'));
            $('#TemplateDiv').hide();
            var sblRep = ActualFileName;
            var EditFilePath = sblRep.replace(/\^/g, '/');
            EditFilePath = EditFilePath.split("\\").pop();            
            if (ActualFileName != "") {                
                $('#UploadExcelFile').show();                
                $("#QuicksmsorCampaign_ExcelFile").next('.filename').text(EditFilePath);
            }
            if (GroupIds != "") {
                $('#Group').trigger('click');
                $('#GroupIds').prop('checked', true);
                $('#GroupIds').attr('checked', 'checked');
            }
            if (Status == "Paused") {
                $("#QuicksmsorCampaign_CampaignNameorRecipient,#QuicksmsorCampaign_SenderId,#QuicksmsorCampaign_CampTypeID, #RecipentsDiv button, #RecipentsDiv input, #GroupsDiv input, #Schedulefield input,#Schedulefield select, #QuicksmsorCampaign_AllowDups, #QuicksmsorCampaign_MobileNumberField, #UploadExcelFile input, #UploadExcelFile button").attr('disabled', true);
            }
            if (Status == "Scheduled") {
                $("#QuicksmsorCampaign_CampaignNameorRecipient").attr('disabled', true);
            }
            $("#hdnCampID").val(QSMSID);
            $("#TemplateDiv").hide();
            $("#QuicksmsorCampaign_CampaignNameorRecipient").val(CampName);
                $("#QuicksmsorCampaign_SenderId").val(SenderID);
                if ($("#QuicksmsorCampaign_SenderId option:selected").text() == "Any") {
                    $("#divAnySender").css("display", "block");
                    $("#QuicksmsorCampaign_AnySender").val(SenderName);
                    $("#QuicksmsorCampaign_AnySender").removeAttr("disabled", "disabled");
                }
                else {
                    $("#divAnySender").css("display", "none");
                }

            var keyflag = '@System.Configuration.ConfigurationManager.AppSettings["IndianSynapse"]';
            if (keyflag == "true") {
                var dvalue = $('#QuicksmsorCampaign_SenderId option:selected').text();
                $('#QuicksmsorCampaign_CampTypeID').attr('disabled', false);

                if ($.isNumeric(dvalue)) {
                    $('#QuicksmsorCampaign_CampTypeID').attr('disabled', true);
                    $('#QuicksmsorCampaign_CampTypeID').prop('disabled', true);
                }
            }

            $("#QuicksmsorCampaign_CampTypeID").val(CampaignTypeID);
            //$("#QuicksmsorCampaign_MobileNumberField").val(MobileField);
            if (LangID == 1) {
                $('.english').attr("checked", true);
                $('.english').prop("checked", true);
                $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
            } else {
                $('.arabic').attr("checked", true);
                $('.arabic').prop("checked", true);
                if (Message.replace(/’/g, "'").match(arabiclan)) {
                    $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'rtl').attr('lang', 'ar');
                }
                else {
                    $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'ltr').attr('lang', 'ar');
                }

            }
            var msg = "";
            var key1 = "$HDC$";
            var key2 = "$HDCD$";

            //msg = Message.replaceAll(key1, "'").replaceAll(key2, "\"");

            msg = replaceAll(key1, "'", Message);
            msg = replaceAll(key2, "\"", msg);
            msg = replaceAll("&#10;", "\r\n", msg);
            msg = replaceAll("$nl$", "\r\n", msg);
            msg = replaceAll("$sq$", "'", msg);
            msg = replaceAll("^^", '"', msg);
            msg = replaceAll("Ø", "\\", msg);
            msg = replaceAll("~~", '"', msg);
            msg = replaceAll("qzzzq", "%", msg);

            $("#QuicksmsorCampaign_Message").val(msg);
            $("#QuicksmsorCampaign_PreviewMessage").val(msg);

            var cname = "";
            cname = replaceAll("Ø", "\\", CampName);
            cname = replaceAll("ÞÞ", "^", cname);
            cname = replaceAll("qzzzq", "%", cname);
            $("#QuicksmsorCampaign_CampaignNameorRecipient").val(cname);

            fnShowCount();
            if (DLR == 1) {
                $("#QuicksmsorCampaign_DeliveryReport").prop("checked", true);
                $("#QuicksmsorCampaign_DeliveryReport").attr("checked", true);
            } else {
                $("#QuicksmsorCampaign_DeliveryReport").removeProp("checked");
                $("#QuicksmsorCampaign_DeliveryReport").removeAttr("checked");
            }

            if (CampaignTypeID == 2) {
                $("#QuicksmsorCampaign_CampTypeID").prop("checked", true);
                $("#QuicksmsorCampaign_CampTypeID").attr("checked", true);
            } else {
                $("#QuicksmsorCampaign_CampTypeID").removeProp("checked");
                $("#QuicksmsorCampaign_CampTypeID").removeAttr("checked");
            }




@using Synapse.Web.CampaignPlugin.Models
@using Core.Models.Enums;
@using Synapse.Web.CampaignPlugin.Helpers.SecureAccess;
@using Core.Models.Dtos.CommonDtos
@inject IConfiguration Configuration;
@inject IHttpContextAccessor HttpContextAccessor;

@model List<QuickSMSOrCampaign>
@{
    var lz = SessionExtensions.GetItem<LocalizationResponse>(HttpContextAccessor.HttpContext.Session);
}

<div class="table-responsive">
    <table class="table table-striped table-bordered dataTable gridtable">
        <thead>
            <tr>
                <td style="display:none;">@lz.Id</td>
                <th>@lz.RecipientS</th>
                <th>@lz.Message</th>
                <th>@lz.SenderID</th>
                <th>@lz.Category</th>
                <th>@lz.Language</th>
                <th>@lz.Credits</th>
                <th>@lz.SendDate</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)//.OrderByDescending(x => x.QuickOrCampaignId))//(Model.OrderBy(x => x.AddedDate)))
            {
                var message = item.Message.Replace("$", "'").Replace("^", "\"").Replace("**", "/\r\n/g").Replace("&#10;", System.Environment.NewLine).Replace("'nl'", System.Environment.NewLine).Replace("&#39;", "'").Replace("&quot;", "\"").Replace("&lt;", "<").Replace("&gt;", ">");
                <tr>
                    <td style="display:none;">@item.QuickOrCampaignId</td>
                    <td>
                        @if (@item.CampaignNameorRecipient != null)
                        {
                            <a href="#" onclick="javascript: OnViewClick('@item.CampaignNameorRecipient','@item.Sender','@item.Language','@item.Message.Replace("\\", "Ø")','@item.CreditsUsed','@item.TotalQSMSCredits','@item.Dlr','@item.AddedDate','@item.Status','Edit')" id="DisplayID" class="" title="View" data-target="#demo-lg-modal" data-toggle="modal">

                                @if (@item.CampaignNameorRecipient.Length >= 15)
                                {
                                    @item.CampaignNameorRecipient.Substring(0, 15) @Html.Raw("...")
                                    ;
                                }
                                else
                                {
                                    @item.CampaignNameorRecipient
                                }
                            </a>
                        }
                    </td>
                    <td style="word-break:break-all">
                        @if (@item.Message.Length >= 6)
                        {
                            @message.Substring(0, 6) @Html.Raw("...")
                            ;
                        }
                        else
                        {
                            @message
                        }
                    </td>
                    <td>@item.Sender</td>
                    <td>@item.category</td>
                    <td>
                        @if (Configuration["IndianSynapse"] == "true")
                        {
                            if (@item.Language == "Arabic")
                            {
                                <span>Unicode</span>
                            }
                            else
                            {
                                @item.Language
                            }
                        }
                        else
                        {
                            @item.Language
                        }
                    </td>
                    <td>@item.CreditsUsed</td>
                    <td>@item.AddedDate</td>
                </tr>
            }
        </tbody>
    </table>
</div>
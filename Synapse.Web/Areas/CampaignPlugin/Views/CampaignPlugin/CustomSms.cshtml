    function OnChangeTemplate(cntrl) {
        var arabiclan = /[\u0621-\u064A]/;
        if ($(cntrl).val() != 0) {
            $('#ActualTemplate').val("");
            $('#AddFields #tbllength tbody').html("");
            $("#hdnCustTmptStat").val(0);
            removeerrorstylectrolfocus('#QuicksmsorCampaign_Message');
            LoadCustomColumns($(cntrl).val());
            // var TempLang = $('#QuicksmsorCampaign_TemplateID').val().split('$VMHDC$')[1];
            //var TempText = $('#QuicksmsorCampaign_TemplateID').val().split('$VMHDC$')[2];
            var TempLang = $('#QuicksmsorCampaign_TemplateID  option:selected').attr('data-lang');
            var TempText = $('#QuicksmsorCampaign_TemplateID  option:selected').attr('data-msg');
            $("#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage").val("");
            $("#QuicksmsorCampaign_Message").val(TempText.replace(/{/g, '<$').replace(/}/g, '$>'));
            $("#QuicksmsorCampaign_PreviewMessage").val(TempText.replace(/{/g, '<$').replace(/}/g, '$>'));
            $('#ActualTemplate').val("").val(TempText.replace(/{/g, '<$').replace(/}/g, '$>'));
            if (TempLang == 1) {
                $('.english').attr("checked", true);
                $('.english').prop("checked", true);
                $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
            } else {
                $('.arabic').attr("checked", true);
                $('.arabic').prop("checked", true);
                var msgval = $('#QuicksmsorCampaign_Message').val();
                // var msgvall = $('#QuicksmsorCampaign_PreviewMessage').val();
                if (msgval.match(arabiclan)) {
                    $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'rtl').attr('lang', 'ar');
                }
                else {
                    $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'ar');
                }
            }
            fnShowCount();
            $("#MapCustomColumnsdiv").show();
        } else {
            removeerrorstylectrolfocus('#QuicksmsorCampaign_Message');
            $('.english').attr("checked", true);
            $("#QuicksmsorCampaign_Message").focus().attr('dir', 'left').attr('lang', 'en').val("");
            $("#QuicksmsorCampaign_PreviewMessage").focus().attr('dir', 'left').attr('lang', 'en').val("");
            //$('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
            fnShowCount();
            $('#ActualTemplate').val("");
        }
    }


    function OnViewClick(QSMSName, Sender, Lang, Message, CreditsUsed, TotalCredits, Dlr, AddedDate, Status, RecipentID, ValidCount, ScheduleDate, ActualFileName, GroupIds, Edit) {
        var GrpName = "";
        // var e_msg = Message;
        var e_msg = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(Message.replaceAll("^^",'"').replaceAll("^", "ÞÞ")), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
        $.each(GroupIds.split(','), function (i, item) {
            var Checkboxes = $("#GroupsDiv").find("input[type=checkbox]");
            $.each(Checkboxes, function (i, CB) {
                if ($(CB).attr("id") == item) {
                    GrpName += $(CB).attr("data-id") + ",";
                }
            });
        });
        var QSMSName = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse(QSMSName), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();

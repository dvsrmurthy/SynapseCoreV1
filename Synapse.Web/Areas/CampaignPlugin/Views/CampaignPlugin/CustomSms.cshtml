@section scripts{
    <script type="text/javascript">
        $("#hdnCustTmptStat").val(0);
        $("#DeleteFile").attr("disabled", true);
        $("#MapCustomDiv").hide();
        $("#MapCustomColumnsdiv").hide();

        $("#QuicksmsorCampaign_MobileNumber").attr("title", "@lz.PleaseenterrecipientmobilenumbersalongwithcountrycodeEg9715097155");
        var $remaining = $('#remaining'),
            $QuicksmsorCampaign_Message = $remaining.next();

        function isUnicode(s) { return /[^\u0000-\u00ff]/.test(s); }




    </script>
    <script type="text/javascript">


        $("#msg-display,#TemplateDiv").hide();
        //$('#show-msgpreview,#test-msgpreview').hide();
        $('#test-msgpreview').hide();
        $('.p-icon').click(function (event) {
            if ($("#QuicksmsorCampaign_Template").is(":checked") && $('#QuicksmsorCampaign_TemplateID').val() != '0') {
                if (!confirm("Are you sure Template columns are mapped correctly")) {
                    return false;
                }
            }
            if ($("#show-msgpreview").is(':visible')) {
                //$("#show-msgpreview").hide();
                $("#show-msgpreview").show();
            } else {
                CustomePreViewGenaration();
                if ($("#QuicksmsorCampaign_Message").val() == "") {
                    $('.p-icon').removeAttr("data-target", "#msg-pre");
                    $("#QuicksmsorCampaign_Message").parent().find(".error").remove();
                    $("#QuicksmsorCampaign_Message").css("border", "1px solid red");
                    $("#QuicksmsorCampaign_Message").parent().append('<div class="error" style="color: red; height:10px !important;">@lz.PleaseEnterMessage</div>');
                }

                else {
                    $('.p-icon').attr("data-target", "#msg-pre");
                }

            }
        });


        $('.p-iconTest').click(function (event) {
            if ($("#show-msgpreview").is(':visible')) {
                $("#show-msgpreview").show();
            } else {
                CustomePreViewGenaration();
                if ($("#QuicksmsorCampaign_Message").val() == "") {
                    $('.p-iconTest').removeAttr("data-target", "#msg-pre");
                    $("#QuicksmsorCampaign_Message").parent().find(".error").remove();
                    $("#QuicksmsorCampaign_Message").css("border", "1px solid red");
                    $("#QuicksmsorCampaign_Message").parent().append('<div class="error" style="color: red; height:10px !important;">@lz.PleaseEnterMessage</div>');
                }

                else if ($("#QuicksmsorCampaign_MobileNumber").val() == "") {
                    $('.p-iconTest').removeAttr("data-target", "#msg-pre");
                    $("#QuicksmsorCampaign_MobileNumber").parent().find(".error").remove();
                    $("#QuicksmsorCampaign_MobileNumber").css("border", "1px solid red");
                    $("#QuicksmsorCampaign_MobileNumber").parent().append('<div class="error" style="color: red; height:10px !important;">please enter mobileNos</div>');
                }

                else {
                    $('.p-iconTest').attr("data-target", "#msg-pre");
                }
            }
            // MsgReplace($("#QuicksmsorCampaign_Message").val());
            //$(".close-btn span").toggleClass("icomoon-icon-close iconred");
        });


        function CustomePreViewGenaration() {
            var message = $("#QuicksmsorCampaign_Message").val();
            var GroupIds = "";
            var uploadType = "FILE";
            if ($("#UploadGroupFile ").is(':visible')) {
                uploadType = "GROUP";
                var SelectedGroups = $("#UploadGroupFile").find("input[type=checkbox]:checked");
                $.each(SelectedGroups, function (i, item) {
                    GroupIds += $(item).val() + ",";
                });
                GroupIds.trim(',');
            }
            if ($("#QuicksmsorCampaign_MessageField option").length > 1) {
                var hdnMsgFields = $("#hdnTextReplace").val().split('||');
                var PlaceHolders = "";
                $.each(hdnMsgFields, function (i, item) {
                    //var replaceItem = "<$" + item.split('::')[0] + "$>";
                    var replaceItem = item.split('::')[0];
                    if (item.split('::')[0] != "") {
                        PlaceHolders += replaceItem + ",";
                    }
                });
            }
            var SheetName = "";
            var PreStatus = true;

            if (!$("#UploadExcelFile").is(':visible') && !$("#UploadGroupFile ").is(':visible')) {
                $("#RecipentsDiv").attr('style', 'border: 1px solid red !important');
                AddError("#RecipentsDiv", "@lz.PleaseSelectRecipientDetails");
                if ($("#TestSMSPreviewTemplate").val() == "")
                    PreStatus = false;
            }

            if (uploadType == "FILE") {
                if ($("#UploadExcelFile").is(':visible')) {
                    if ($("#QuicksmsorCampaign_ExcelFile").text() == "") {
                        $("#QuicksmsorCampaign_ExcelFile").attr('style', 'border: 1px solid red !important');
                        AddError("#QuicksmsorCampaign_ExcelFile", "@lz.pleaseselectfile");
                        if ($("#TestSMSPreviewTemplate").val() == "")
                            PreStatus = false;
                    }
                    if ($("#SelectSheet").is(':visible')) {
                        SheetName = $("#QuicksmsorCampaign_SheetID option:selected").text();
                        if ($("#QuicksmsorCampaign_SheetID").val() == 0) {
                            $("#QuicksmsorCampaign_SheetID").attr('style', 'border: 1px solid red !important');
                            AddError("#QuicksmsorCampaign_SheetID", "@lz.pleaseselectSheet");
                            if ($("#TestSMSPreviewTemplate").val() == "")
                                PreStatus = false;
                        }

                    }

                }

            } else if (uploadType == "GROUP") {
                if ($("#UploadGroupFile").find("input[type=checkbox]:checked").length <= 0) {
                    $("#GroupsDiv").attr('style', 'border: 1px solid red !important');
                    AddError("#GroupsDiv", "@lz.pleaseselectGroups");
                    PreStatus = false;
                }

            }
            if ($("#QuicksmsorCampaign_Message").val() == "") {
                $("#QuicksmsorCampaign_Message").attr('style', 'border: 1px solid red !important');
                AddError("#QuicksmsorCampaign_Message", "@lz.PleaseEnterMessage");
                PreStatus = false;
            }
            if ($('#QuicksmsorCampaign_MobileNumberField').val() == 0) {
                $("#QuicksmsorCampaign_MobileNumberField").attr('style', 'border: 1px solid red !important');
                AddError("#QuicksmsorCampaign_MobileNumberField", "@lz.pleaseselectmobilenumberfield");
                PreStatus = false;
            }
            //if ($('#AddFields #tbllength tbody tr').length <= 0) {
            //    errorMessage('Please map atleast one Custom message field');
            //    $("html, body").animate({ scrollTop: 0 }, 600);
            //    PreStatus = false;
            //}
            if ($("#QuicksmsorCampaign_Template").is(":checked")) {
                if ($("#hdnCustTmptStat").val() == 0) {
                    errorMessage('Please Select Template');
                    $("html, body").animate({ scrollTop: 0 });
                    PreStatus = false;
                }

            }
            if (PreStatus) {
                var arabiclan = /[\u0621-\u064A]/;
                GroupIds = GroupIds == "" ? $("#TestSMSCGroupIds").val() : GroupIds;
                removeerrorstylectrolfocus("#QuicksmsorCampaign_Message");
                var MobileField = $('#QuicksmsorCampaign_MobileNumberField option:selected').text();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("OnCustomPreview", "CampaignPlugin")',
                    headers: headers,
                    data: { message: message, GroupIds: GroupIds, uploadType: uploadType, PlaceHolders: PlaceHolders.trim(','), MobileField: MobileField, SheetName: SheetName, cmd: "_CustomPreView", msgt: ($("#TestSMSPreviewTemplate").val() + "|-|" + $("#QuicksmsorCampaign_MobileNumber").val()) },
                    datatype: 'application/json',
                    success: function (d) {
                        if (d != (null || undefined)) {
                            //$('#show-msgpreview, #hide-msglist').slideToggle();
                            $('#hide-msglist').slideToggle();
                            $("#CustomPreViewDiv").html('');
                            $("#CustomPreViewDiv").html(d.PartialResult);
                            if ($("#QuicksmsorCampaign_Template").is(":checked")) {
                                if ($("#hdnCustTmptStat").val() != 0) {
                                    if ($("#CustomPreViewDiv .innermsg").text().match(/\<\$.*?\$\>/g)) {
                                        alert('Please map all the template columns');
                                        $('#msg-pre .modal-header button').trigger('click');
                                        return false;
                                    }
                                }
                            }
                            if ($('.english').is(":checked")) {
                                $('.english').attr("checked", true);
                                $('.english').prop("checked", true);
                                $('#QuicksmsorCampaign_Message,.innermsg').focus().attr('dir', 'left').attr('lang', 'en');
                            } else {
                                $('.arabic').attr("checked", true);
                                $('.arabic').prop("checked", true);
                                var msgval = $('#QuicksmsorCampaign_Message').val();
                                var msgvall = $('.innermsg').val();
                                if (msgval.match(arabiclan) || msgvall.match(arabiclan)) {
                                    $('#QuicksmsorCampaign_Message,.innermsg').focus().attr('dir', 'rtl').attr('lang', 'ar');
                                }
                                else {
                                    $('#QuicksmsorCampaign_Message,.innermsg').focus().attr('dir', 'left').attr('lang', 'ar');
                                }
                            }

                        }
                    },
                    error: function (xhr, error, status) {


                    }
                });
            }
        }





        $('#TestSms').click(function (event) {
            if ($("#QuicksmsorCampaign_SenderId option:selected").text() == "Any") {
                if ($("#QuicksmsorCampaign_AnySender").val().length == 0) {
                    $("#QuicksmsorCampaign_AnySender").attr("rc", "y");
                    $("#QuicksmsorCampaign_AnySender").focus();
                }
            }
            else {
                $("#QuicksmsorCampaign_AnySender").attr("rc", "n");
            }
            var arabiclan = /[\u0621-\u064A]/;
            var unicodelan = /[\u0000-\u007F]/;
            if ($("#QuicksmsorCampaign_Template").is(":checked")) {
                $("#QuicksmsorCampaign_TemplateID").attr("rc", "y");
            } else {
                $("#QuicksmsorCampaign_TemplateID").attr("rc", "n");
            }
            if ($("#UploadExcelFile").is(':visible')) {
                $("#QuicksmsorCampaign_ExcelFile").attr("rc", "y");
            } else {
                $("#QuicksmsorCampaign_ExcelFile").attr("rc", "n");
            }
            if ($("#SelectSheet").is(':visible')) {
                $("#QuicksmsorCampaign_SheetID").attr("rc", "y");
            } else {
                $("#QuicksmsorCampaign_SheetID").attr("rc", "n");
            }
            var msgVal = $("#QuicksmsorCampaign_Message").val().replace(/’/g, "'");
            if (msgVal.match(/[^\u0000-\u007F]/) && $(".english").is(":checked")) {
                alert('@lz.Pleasechoosecorrectlanguage');
                return false;
            }
            if (!msgVal.match(/[^\u0000-\u007F]/) && $(".arabic").is(":checked")) {
                alert('@lz.Pleasechoosecorrectlanguage');
                return false;
            }

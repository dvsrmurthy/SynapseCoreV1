                    else {
                        $("#hdnTextReplace").val("");
                        var TextReplace = "";
                        $("#QuicksmsorCampaign_MobileNumberField, #QuicksmsorCampaign_MessageField").html("");
                        $('#QuicksmsorCampaign_MobileNumberField').append($('<option></option>').val(0).html("--Select MobileNo Field--"));
                        $('#QuicksmsorCampaign_MessageField').append($('<option></option>').val(0).html("--Select Message Field--"));
                        var i = 1;
                        $.each(data.FileRecord, function (key, val) {
                            $('#QuicksmsorCampaign_MobileNumberField').append($('<option></option>').val(i).html(key));
                            $('#QuicksmsorCampaign_MessageField').append($('<option></option>').val(i).text(key));
                            TextReplace += key + "::" + val + "||";
                            i++;
                        });
                        $("#hdnTextReplace").val(TextReplace);
                        $("#QuicksmsorCampaign_MobileNumberField option").filter(function () { return ($(this).text() == MobileField) }).attr('selected', true);

                    }
                },
                error: function (xhr, status) {
                    $("#QuicksmsorCampaign_ExcelFile").val("");
                    $(".filename").text("@lz.NofileSelected");
                    $("#hdnFilePath").val(0);
                    $("#DeleteFile").attr("disabled", true);
                    errorMessage("@lz.ExceptionOccured");
                    $("html,body").animate({ scrollTop: 0 }, 200);
                }
            });
        }



@inject IHttpContextAccessor HttpContextAccessor;

@model QuickSMSOrCampaignMain
@{
    var ExtendedUser = HttpContextAccessor.HttpContext.Session.GetItem<CustomeUser>();
    List<SelectListItem> SendersList = new List<SelectListItem>();
    var SenderColomns = Model.Senders;
    if (SenderColomns != null && SenderColomns.Any())
    {
        SendersList = SenderColomns.Select(x => new SelectListItem { Value = x.SenderID.ToString(), Text = x.SenderName }).ToList();
        if (SendersList.Count > 1)
        {
            SendersList.Insert(0, new SelectListItem { Value = "0", Text = "--Select Sender ID--" });
        }
    }
    //List<SelectListItem> CampaignTypes = new List<SelectListItem>();
    //var CampTypes = Model.CampaignTypes;
    //if (CampTypes != null && CampTypes.Any())
    //{
    //    CampaignTypes = CampTypes.Select(x => new SelectListItem { Value = x.CampTypeID.ToString(), Text = x.CampType }).ToList();
    //   // CampaignTypes.Insert(0, new SelectListItem { Value = "0", Text = "--Select CampaignType--" });
    //}
    List<SelectListItem> Hours = new List<SelectListItem>();
    for (int i = 1; i <= 23; i++)
    {
        var hrsvalue = "";
        if (i < 10) { hrsvalue = "0" + i; }
        else { hrsvalue = i.ToString(); }
        SelectListItem item = new SelectListItem { Value = i.ToString(), Text = hrsvalue };
        Hours.Add(item);
    }
    List<SelectListItem> Minutes = new List<SelectListItem>();
    for (int j = 0; j <= 59; j++)
    {
        var MinValue = "";
        if (j < 10) { MinValue = "0" + j; }
        else { MinValue = j.ToString(); }
        SelectListItem item = new SelectListItem { Value = j.ToString(), Text = MinValue };
        Minutes.Add(item);
    }
    var Msgmodel = Model.ExtGSMCharecters;
    var lz = HttpContextAccessor.HttpContext.Session.GetItem<LocalizationResponse>();
    //var basePath = System.Configuration.ConfigurationManager.AppSettings["tempPathVirtualPath"] + "\\" + "SampleFile.xlsx";
    var basePath = Configuration["tempPathVirtualPath"] + "\\" + "CommonFiles" + "\\" + "SampleFile.xlsx";
}
<style type="text/css">
    .tooltip.in {
        width: 400px;
    }

    .popover {
        max-width: 420px;
    }

    /* Uploader */

    div.uploader {
        position: relative;
        overflow: hidden;
        cursor: default;
        border: 1px solid #ddd;
        padding: 5px 12px;
    }

        div.uploader span.action {
            float: right;
            display: inline;
            padding: 3px 0px;
            overflow: hidden;
            cursor: pointer;
            margin-top: -1px;
            text-indent: inherit;
            width: 28px;
            background: #eee;
            text-align: center;
        }


        div.uploader span.filename {
            margin: 1px;
            float: left;
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            cursor: default;
        }



        div.uploader input {
            opacity: 0;
            filter: alpha(opacity:0);
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            float: right;
            height: 25px;
            border: none;
            cursor: default;
        }

    .handset {
        word-break: break-all;
        padding: 51px 12px;
        /*background-image: url(../../Content/images/iphone3.png);*/
        color: #111;
    }

    .innermsg {
        height: 328px;
        width: 188px;
        /* overflow-y: scroll; */
        /* overflow-x: hidden; */
        resize: none;
        border: none;
    }

    .padrt {
        margin-right: 8px !important;
    }

    .noleftpad {
        padding-left: 0px;
    }
</style>

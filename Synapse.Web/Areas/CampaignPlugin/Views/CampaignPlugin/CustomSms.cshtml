                            window.location.reload(false);
                        }, 2000);
                    }
                    else if (d == "MsgSubittedToChecker") {
                        //successMessage("Campaign submitted successfully");
                        //$("html body").animate({ scrollTop: 0 });
                        //setTimeout(function() {
                        //    window.location.reload(false);
                        //}, 2000);

                        campsmsg("@lz.Campaignsubmittedsuccessfully", true, '@Url.Action("_CustomSMSTable", "CampaignPlugin", new { Area = "CampaignPlugin" })', "PartialCustomers");
                        // clearparent('ADDForm', 'QuickSMSOrCampaign_');
                        hiddenvalues();

                    } else if (d == "CustInActive") {
                        errorMessage("@lz.CustomerisinInActivestate  ");
                        $("html body").animate({ scrollTop: 0 });
                        //setTimeout(function () {
                        //    window.location.reload(false);
                        //}, 2000);
                    } else if (d == "CustExpired") {
                        errorMessage("@lz.CustomerExpired");
                        $("html body").animate({ scrollTop: 0 });
                        //setTimeout(function () {
                        //    window.location.reload(false);
                        //}, 2000);
                    } else if (d == "CustPrefInActive") {
                        errorMessage("@lz.CustomerPreferencesareinInActiveState");
                        $("html body").animate({ scrollTop: 0 });
                        //setTimeout(function () {
                        //    window.location.reload(false);
                        //}, 2000);
                    } else if (d == "InsufficentCredits") {
                        errorMessage("@lz.InsufficientCredits");
                        $("html body").animate({ scrollTop: 0 });
                        //setTimeout(function () {
                        //    window.location.reload(false);
                        //}, 2000);
                    } else if (d == "UpdatedSuccessfully") {
                        //successMessage("Campaign Updated Successfully.");
                        //$("html body").animate({ scrollTop: 0 });
                        //setTimeout(function() {
                        //    window.location.reload(false);
                        //}, 2000);
                        campsmsg("@lz.Campaignsubmittedsuccessfully", true, '@Url.Action("_CustomSMSTable", "CampaignPlugin", new { Area = "CampaignPlugin" })', "PartialCustomers");
                        // clearparent('ADDForm', 'QuickSMSOrCampaign_');
                        hiddenvalues();
                    } else if (d == "DuplicateName") {
                        errorMessage("@lz.CampaignNamealreadyExists");
                        $("html body").animate({ scrollTop: 0 });
                        //setTimeout(function () {
                        //    window.location.reload(false);
                        //}, 2000);
                    } else if (d == "InvalidSchedule") {
                        errorMessage("@lz.ScheduletimeshouldbegreatherthancurrentdatetimeincludingPreProcessTime");
                        $("html body").animate({ scrollTop: 0 });

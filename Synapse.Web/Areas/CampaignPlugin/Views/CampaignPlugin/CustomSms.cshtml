                                            // $('.warningmessage').html('Invalid file format').addClass('alert alert-danger').delay(4000).fadeOut();
                                            $("#QuicksmsorCampaign_ExcelFile").val('');
                                            $('.filename').html("@lz.NofileSelected");
                                            $("html,body").animate({ scrollTop: 0 }, 200);
                                            return false;
                                        }


                                        if (ext == "xls" || ext == "xlsx") {
                                            $("#SelectSheet").show();
                                            $('#QuicksmsorCampaign_SheetID').html("");
                                            $('#QuicksmsorCampaign_SheetID').append($('<option></option>').val(0).html("--Select Sheet--"));


</div>

<div class="row">
    <div class="col-xs-12">
        <div class="panel">
            <div class="panel-heading">
                <h3 class="panel-title">Simple SMS</h3>
            </div>

            <!--Data Table-->
            <!--===================================================-->
            <div class="panel-body">
                <div>
                    @Html.Partial("_SimpleSms", Model.SimpleSmsTable)
                </div>
            </div>
            <!--===================================================-->
            <!--End Data Table-->

        </div>
    </div>


        @*///////////////////////////View Form Starts Here///////////////////////////////////*@
        <div id="demo-lg-modal" class="modal fade" tabindex="-1">
            <div class="modal-dialog modal-md">
                <div class="modal-content View-list" id="ViewForm">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal"><i class="pci-cross pci-circle"></i></button>
                        <h4 class="modal-title" id="myLargeModalLabel">TestSMSC View</h4>
                    </div>

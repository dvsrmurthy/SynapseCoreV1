                                </div>
                            </div>
                            <!-- End Form group -->

                        </div>
                        <!--First tab-->

                        <!--Second tab-->
                        <div id="demo-step-tab2" class="tab-pane fade">
                            <div class="form-group">
                                <div class="col-lg-6 col-lg-offset-3">
                                    @*<div class="radio">*@
                                        @Html.RadioButtonFor(x => x.SimpleSms.Language, "English", new { @name = "language" }) <label for="Language">English</label>
                                        @Html.RadioButtonFor(x => x.SimpleSms.Language, "Arabic", new { @name = "language" }) <label for="Language">Arabic</label>
                                    @*</div>*@
                                </div>
                            </div>


                            <!-- Form Group -->
                            <div class="form-group">
                                <div class="col-lg-6 col-lg-offset-3">
                                        @Html.CheckBoxFor(x => x.SimpleSms.Template)

                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td><input type="checkbox" class="ChildCB" data-parent="C" data-id="971516412562" value="971516412562"></td>
                                                    <td>RAVI1</td>
                                                    <td>971516412562</td>
                                                </tr>
                                                <tr>
                                                    <td><input type="checkbox" class="ChildCB" data-parent="C" data-id="971516412563" value="971516412563"></td>
                                                    <td>RAVI8</td>
                                                    <td>971516412563</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="panel-footer">
                                        <button type="button" class="btn btn-primary">Save</button>
                                        <button id="closecontacts" type="button" class="next btn btn-default">Close</button>
                                    </div>

                                </div>
                            </div>
                            <!-- End Form group -->
                            <!-- End Form group -->
                            <div class="form-group">
                                <div class="col-sm-offset-3 col-sm-6">
                                @Html.DropDownListFor(x => x.SimpleSms.SenderId, new List<SelectListItem>
                                {
                                    new SelectListItem{ Text="Sender ID 1", Value = "1" },

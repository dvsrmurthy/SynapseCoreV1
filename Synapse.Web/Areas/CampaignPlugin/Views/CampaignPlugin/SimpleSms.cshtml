                        <span class="icon-wrap icon-wrap-xs icon-circle bg-gray">
                            <span class="wz-icon icon-txt ">1</span>
                            <i class="wz-icon-done fa fa-check "></i>
                        </span>
                        <small class="wz-desc">Compose Test SMSC <i class="fa fa-angle-double-right" aria-hidden="true"></i></small>
                    </a>
                </li>
                <li class="col-xs-4 bg-info pad-ver">
                    <a data-toggle="tab" href="#demo-step-tab2" aria-expanded="false">
                        <span class="icon-wrap icon-wrap-xs icon-circle bg-gray ">
                            <span class="wz-icon icon-txt ">2</span>
                            <!-- <i class="wz-icon-done fa fa-check"></i>-->
                            <i class="wz-icon-done fa fa-check "></i>
                        </span>
                        <small class="wz-desc">Message Details <i class="fa fa-angle-double-right" aria-hidden="true"></i></small>
                    </a>
                </li>

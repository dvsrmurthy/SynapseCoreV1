                                <div class="col-sm-offset-3 col-sm-6">
                                    <div class="qsmsPhonebook">
                                        <table class="table table-striped table-bordered">
                                            <thead>
                                                <tr>
                                                    <th><input type="checkbox" id="ParentCB" data-parent="All" onclick="CheckAllContacts(this)"> All</th>

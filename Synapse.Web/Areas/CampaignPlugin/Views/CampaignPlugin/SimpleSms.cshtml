@using Synapse.Web.CampaignPlugin.Models;
@model SimpleSmsMain

<!--Large Bootstrap Modal-->
<!--===================================================-->
<div id="msg-preview" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg" style="width: 800px">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal"><i class="pci-cross pci-circle"></i></button>
                <h4 class="modal-title" id="myLargeModalLabel">Simple SMS Preview</h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-8">

                        <!-- Campaign Preview -->
                        <div class="camppreview">

                            <div class="col-sm-6 impdetails">
                                <span class="detailinfo">Contacts</span>
                                <span class="detailvalue">10</span>
                            </div>

                            <div class="col-sm-3 impdetails">
                                <span class="detailinfo">Characters</span>
                                <span class="detailvalue">129</span>
                            </div>

                            <div class="col-sm-3 impdetails">
                                <span class="detailinfo">Credits</span>
                                <span class="detailvalue">1</span>
                            </div>

                            <div class="col-sm-8 impdetails">
                                <span class="sidlanginfo">Sender ID</span>
                                <span class="sidlangvalue">Synapse</span>
                            </div>

                            <div class="col-sm-4 impdetails">
                                <span class="sidlanginfo">Language</span>
                                <span class="sidlangvalue">English</span>
                            </div>

                            <div class="campotherdetails">

                                <dl>
                                    <dt>SMS Type</dt>
                                    <dd>Test SMSC</dd>
                                </dl>

                                <dl>
                                    <dt>Delivery Report</dt>
                                    <dd>Yes</dd>
                                </dl>

                                <dl>
                                    <dt>Allow Duplicates</dt>
                                    <dd>Yes</dd>
                                </dl>
                            </div>

                        </div>
                    </div>
                    <div class="col-sm-4" style="position:relative"><textarea class="phoneprview"></textarea><img src="~/Content/images/iphoneplain.png" /></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="next btn btn-success" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>
<!--===================================================-->
<!--End Large Bootstrap Modal-->

<div class="panel">

    <div id="message"></div>

    <!-- Bubble Numbers Form Wizard -->
    <!--===================================================-->
    <div id="demo-step-wz">

        <div class="wz-heading wz-w-label">
            <!--Wizard Nav-->

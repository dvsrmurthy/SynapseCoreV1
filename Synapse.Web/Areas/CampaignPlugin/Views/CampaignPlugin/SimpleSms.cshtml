        @*////////////////////////View Form Ends Here/////////////////////////////*@

    </div>



@section scripts{

    <script type="text/javascript">

                    $('.searchdropdown').chosen();

                    var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
                    var headers = {};
                    headers['__RequestVerificationToken'] = antiForgeryToken;

                    function sample(value, act) {
                        if (act != (null || undefined) && act == 'Edit') {
                            clearparent('ADDForm', 'TestSMSC_');
                            internalPost("@Url.Action("OnEditTestSMSC", "SMSCSettingsPlugin")", { id: value }, 'ADDForm', 'TestSMSC_');

                        }
                        else {
                            clearparent('ADDForm', 'TestSMSC_');
                            setTimeout(function () { $("#TestSMSC_User").focus(); }, 1000);

                        }
                    }


                    function TestDetails() {
                        var isValid = validateAjaxclick('#ADDForm');
                        if (isValid) {
                            var d = {
                                User: $('#TestSMSC_User').val(),
                                Recipients: $('#TestSMSC_Recipients').val(),
                                SenderId: $('#TestSMSC_SenderId').val(),
                                Message: $('#TestSMSC_Message').val(),
                                Languagename: $('input:hidden[id=TestSMSC_Languagename]').val()
                            };

                            $.ajax({
                                type: "POST",
                                url: '@Url.Action("TestSMSC", "SMSCSettingsPlugin")',
                                headers: headers,
                                data: d,
                                datatype: 'application/json',
                                success: function (d) {
                                    if (d != (null || undefined)) {
                                        if (d.IsValid) {
                                            smsg(d.Message, true);
                                        }
                                        else {
                                            emsg(d.Message, false);
                                        }
                                    }
                                },
                                error: function (xhr, error, status) {
                                    emsg('error', false);
                                }
                            });

                        }

                    }



                    function OnViewClick(value) {
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("OnEditTestSMSC", "SMSCSettingsPlugin")',
                            headers: headers,
                            data: { id: value, cmd: "View" },
                            datatype: 'application/json',
                            success: function (d) {
                                if (d != (null || undefined)) {
                                    $("#PartialResult").html('');
                                    $("#PartialResult").html(d.PartialResult);
                                }
                            },
                            error: function (xhr, error, status) {

                            }
                        });

                    }
    </script>




    <script type="text/javascript">
                    var $remaining = $('#remaining'),
                    $TestSMSC_Message = $remaining.next();

                    $('#TestSMSC_Message').keyup(function () {
                        var chars = this.value.length,
                            TestSMSC_Message = Math.ceil(chars / 160),
                            remaining = TestSMSC_Message * 0 + (chars % (TestSMSC_Message * 160) || TestSMSC_Message * 160);

                        $remaining.text(remaining + ' character(s),');
                        $TestSMSC_Message.text(TestSMSC_Message + 'SMS Message(s)');
                    });
    </script>

    <script type="text/javascript">
                    $('#show-msgpreview').hide();
                    $('.p-icon').click(function (event) {
                        $('#show-msgpreview, #hide-msglist').slideToggle();
                        //$(".close-btn span").toggleClass("icomoon-icon-close iconred");
                    });

                    $('.close-btn').click(function (event) {
                        $('#show-msgpreview, #hide-msglist').slideToggle();
                    });

    </script>

    <script type="text/javascript">
                    // Text boxes to accept only numbers and comma

                    $('#TestSMSC_Recipients').keydown(function (e) {

                        if (e.shiftKey || e.altKey) {

                            e.preventDefault();
                        } else {

                            var key = e.keyCode;
                            if (!((key == 8) || (key == 46) || (key == 9) || (key >= 35 && key <= 40) || (key >= 48 && key <= 57) || (key >= 96 && key <= 105) || (key == 188) || (e.ctrlKey && key == 86))) {
                                e.preventDefault();
                            }
                            else if (key == 9) {
                            }
                        }

                        $('#TestSMSC_Recipients').bind('paste', function () {
                            var el = this;
                            setTimeout(function () {
                                el.value = el.value.replace(/\D/g, '');
                            }, 0);
                        });

                        $("#TestSMSC_Recipients").bind("drop", function (e) {
                            return false;

                        });
                    });

    </script>


    <script type="text/javascript">
                    $("#TestSMSC_Message").keyup(function () {
                        var value = $(this).val();
                        $("#TestSMSC_PreviewMessage").text(value);
                    }).keyup();

    </script>


    <script type="text/javascript">
                    function Drponchange(value, id) {

                        $("#" + id).val($(value).val());
                    }

                    function Chkonchange(value, id) {
                        $("#" + id).val(value.checked);//$(value).attr("datalang")
                    }

                    function protchange(value, id) {
                        //debugger;
                        $('input:hidden[id=' + id + ']').val($(value).val())
                    }

                    function Rdoonchange(value, id) {
                        //debugger;
                        $('input:hidden[id=' + id + ']').val($(value).attr("datalang"))
                        //$('#TestSMSC_Message').val($('input:hidden[id=' + id + ']').attr("datalang"));

                    }

    </script>
}


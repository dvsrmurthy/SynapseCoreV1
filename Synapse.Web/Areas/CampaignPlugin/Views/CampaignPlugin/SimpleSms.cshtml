                            <span class="wz-icon icon-txt">3</span>
                            <i class="wz-icon-done fa fa-check "></i>
                        </span>
                        <small class="wz-desc">Finish</small>
                    </a>
                </li>

            </ul>
            <!--End Wizard Nav-->
        </div>

        <div class="add-field form-horizontal" id="ADDForm">

            @using (Html.BeginForm("SimpleSMS", "CampaignPlugin", new { Area = "CampaignPlugin" }, FormMethod.Post,  false, new { enctype = "multipart/form-data" }))

@using Synapse.Web.CampaignPlugin.Models
@using Core.Models.Enums;
@using Synapse.Web.CampaignPlugin.Helpers.SecureAccess;
@using Core.Models.Dtos.CommonDtos
@inject IConfiguration Configuration;
@inject IHttpContextAccessor HttpContextAccessor;

@model List<QuickSMSOrCampaign>
@{
    var basePath = ""; var ImportFileName = "";
    var lz = SessionExtensions.GetItem<LocalizationResponse>(HttpContextAccessor.HttpContext.Session);
    string fileNameFrompath = string.Empty;
}
<div class="table-responsive">
    <table class="table table-striped table-bordered dataTable gridtable">
        <thead>
            <tr>
                <th></th>
                <th>@lz.CampaignName</th>
                <th>@lz.SenderID</th>
                <th>@lz.Category</th>
                <th>@lz.Language</th>
                <th>@lz.ValidRecipients</th>
                <th>@lz.CreditsPerMsg</th>
                <th>@lz.ScheduleDate</th>
                <th>@lz.Status</th>
                @if (Model.FirstOrDefault() != null && Model.FirstOrDefault().CustID == 1)
                {
                    <th>Functional Status</th>
                }
                else if (Model.FirstOrDefault() != null && Model.FirstOrDefault().IsCheckerRequired)
                {
                    <th>Functional Status</th>
                }
                <th>@lz.Action</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model)
            {
                var id = item.ActualFileName;
                var isRowEnable = true;
                if (!string.IsNullOrWhiteSpace(item.ImportFileName))
                {
                    ImportFileName = item.ImportFileName;
                    var ImportFilename = item.ImportFileName.Replace("^", "\\");
                    var localDirLen = Configuration["LocalDIR"];
                    var fileName = string.Join("\\", ImportFilename.Split(new string[] { "\\" }, StringSplitOptions.None).Skip(Convert.ToInt32(localDirLen)).ToList());
                    var fileClientName = System.IO.Path.GetFileNameWithoutExtension(fileName).Replace("&", "") + "_client.csv";
                    fileNameFrompath = System.IO.Path.GetFileName(id);
                    basePath = Configuration["tempPathVirtualPath"] + "\\" + System.IO.Path.GetDirectoryName(fileName) + "\\" + fileClientName;
                }

                <tr>
                    <td>
                        @switch (item.RecipientsType)
                        {
                            case FILETYPE.NOTEPAD:
                                <a href="#" class="FileDownload" onclick="downloadFile('@fileNameFrompath')">
                                    <span class="fa fa-file-text-o fa-1x text-primary"></span>
                                </a>
                                break;
                            case FILETYPE.EXCEL:
                                <a href="#" class="FileDownload" onclick="downloadFile('@fileNameFrompath')">
                                    <span class="fa fa-file-excel-o fa-1x text-success"></span>
                                </a>
                                break;
                            case FILETYPE.GROUPS:
                                <span class="fa fa-address-book-o fa-1x text-purple"></span>
                                break;
                        }

                    </td>

                    <td>
                        <a href="#" onclick="javascript: OnViewClick('@item.CampaignNameorRecipient.Replace("^", "ÞÞ").Replace("\\", "^")','@item.Sender','@item.Language','@item.Message.Replace("\"", "^^").Replace("\\", "Ø")','@item.CreditsUsed','@item.ProcessedCount','@item.Dlr','@item.AddedDate','@item.Status','@item.RecipentID','@item.ValidCount','@item.ScheduleDate','@System.IO.Path.GetFileName(ImportFileName.Replace(" \\", "^"))','@item.GroupIds','edit')" id="DisplayID" data-target="#demo-lg-modal" data-toggle="modal" title="View">
                            @item.CampaignNameorRecipient
                        </a>
                    </td>

                    <td>@item.Sender</td>
                    <td>@item.category</td>
                    @*<td>@item.Language</td>*@
                    <td>
                        @if (Configuration["IndianSynapse"] == "true")
                        {
                            if (@item.Language == "Arabic")
                            {
                                <span>Unicode</span>
                            }
                            else
                            {
                                @item.Language
                            }
                        }
                        else
                        {
                            @item.Language
                        }
                    </td>
                    <td>@item.ValidCount</td>
                    <td>@item.CreditsUsed</td>
                    <td>@item.ScheduleDate</td>
                    <td width="100">
                        @if (item.Status == "Completed")
                        {
                            <span class='label label-table label-success'>Completed</span>
                        }
                        else if (item.Status == "Scheduled")
                        {
                            if (item.CurrentStatus == Cstatus.TimeExceeded)
                            {
                                <span class='label label-table label-default'>@item.Status</span>
                            }
                            else
                            {
                                <div class="dropdown">
                                    <a class="btn-link" href="#" data-toggle="dropdown" aria-haspopup="true">
                                        @item.Status
                                        <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu">
                                        @*<li><a href="javascript:SetCampaignEvents('Deactivate')" id="Deactivate">Deactivate</a></li>*@
                                        @*<li><a href="#" onclick="javascript:SetCampaignActivities('@item.QuickOrCampaignId','0','8','Pause')" id="Pause">Pause</a></li>*@
                                        @*<li><a href="#" onclick="javascript:SetCampaignActivities('@item.QuickOrCampaignId','0','4','Resume')" id="Resume">Resume</a></li>*@
                                        <li><a href="#" onclick="SetCampaignActivities('@item.QuickOrCampaignId','0','4','Suspend')" id="Suspend">Suspend</a></li>
                                    </ul>
                                </div>
                            }
                        }
                        else if (item.Status == "Suspended")
                        {
                            <span class='label label-table label-danger'>@item.Status</span>
                        }
                        else if (item.Status == "In Progress")
                        {
                            <span class='label label-table label-info'>@item.Status</span>
                        }
                        else if (item.Status == "Stopped")
                        {
                            <span class='label label-table label-warning'>Stopped</span>
                        }
                        else if (item.Status == "Pending")
                        {
                            <span class='label label-table label-default'>Pending</span>
                        }
                        else
                        {
                            <span class='label label-table label-danger'>@item.Status</span>
                        }
                    </td>
                    @if (item.CustID != null && item.CustID == 1)
                    {
                        <td>
                            @switch (@item.CurrentStatus)
                            {
                                case Cstatus.Approve:
                                    @Html.Raw("<a class='label label-table label-success'>Approved</a>")
                                    break;
                                case Cstatus.Pending:
                                    @Html.Raw("<span class='label label-table label-warning'>Pending</span>")
                                    break;
                                case Cstatus.Rejected:
                                    @Html.Raw("<span class='label label-table label-danger'>Rejected</span>")
                                    break;
                                case Cstatus.TimeExceeded:
                                    @Html.Raw("<span class='label label-table label-info'>TimeExceeded</span>")
                                    break;
                            }
                        </td>
                    }
                    else if (item.IsCheckerRequired)
                    {
                        <td>
                            @switch (@item.CurrentStatus)
                            {
                                case Cstatus.Approve:
                                    @Html.Raw("<a class='label label-table label-success'>Approved</a>")
                                    break;
                                case Cstatus.Pending:
                                    @Html.Raw("<span class='label label-table label-warning'>Pending</span>")
                                    break;
                                case Cstatus.Rejected:
                                    @Html.Raw("<span class='label label-table label-danger'>Rejected</span>")
                                    break;
                                case Cstatus.TimeExceeded:
                                    @Html.Raw("<span class='label label-table label-info'>TimeExceeded</span>")
                                    break;
                            }
                        </td>
                    }
                    <td>
                        @if (item.Status == "Scheduled" && item.CurrentStatus != Cstatus.TimeExceeded && item.CurrentStatus != Cstatus.Rejected)
                        {
                            <a href="javascript: OnEdit('@item.QuickOrCampaignId','@item.CampaignNameorRecipient.Replace("^", "ÞÞ").Replace("\\", "Ø").Replace("%", "qzzzq")','@item.SenderId','@item.Sender','@item.LanguageId','@item.Message.Replace("\"", "^^").Replace("\\", "Ø").Replace("%", "qzzzq")','@item.Dlr','@((item.CampTypeID) ? "2" : "1")','@item.MobileField','@item.ImportFileName','@item.RecipentID','@item.GroupIds','@item.ActualFileName','@item.Sheet','@item.ScheduledType','@item.ScheduleDate','@((item.AllowDups) ? "1" : "0")','@item.Status','@item.RuleId','@item.Remarks','Edit')" class="">
                                <span class="fa fa-pencil-square-o fa-1x" @((item.isRowEnable) ? "" : "disabled='disabled'")></span>
                            </a>
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
    <script>
        $("#QuicksmsorCampaign_category").change(function () {
            LoadSenderByCategory();
        });
        function LoadSenderByCategory() {
            //alert($("#QuicksmsorCampaign_category option:selected").text());
            $('#QuicksmsorCampaign_SenderId').empty();
            $.ajax({
                type: "POST",
                url: '@Url.Action("LoadSenderByCategory")',
                headers: headers,
                data: { category: $("#QuicksmsorCampaign_category option:selected").text()},
                datatype: 'application/json',
                success: function (d) {
                    console.log(d);
                    if (d != (null || undefined)) {                        
                        var items = 0;
                        $.each(d, function (i, item) {                            
                            if (item.Code != "") { 
                                items = items + 1;
                                //alert(items);
                                $('#QuicksmsorCampaign_SenderId').append($('<option>', {
                                    value: item.Id,
                                    text: item.Code
                                }));
                            }
                        });
                        if (items == 0) {
                            $('#QuicksmsorCampaign_SenderId').empty();
                            alert("No senders are configured for the given category!!");
                        }
                    }                    
                },
                error: function (xhr, error, status) {
                    var err = xhr;
                }
            });
        }
    </script>

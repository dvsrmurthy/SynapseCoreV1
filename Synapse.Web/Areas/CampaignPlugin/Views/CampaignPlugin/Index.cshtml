@section scripts{
    <script src="~/js/aes.js"></script>
    <script type="text/javascript">
        var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
        var headers = {};
        headers['__RequestVerificationToken'] = antiForgeryToken;
        $("#ContactsMainDiv, #TemplateDiv").hide();
        //debugger;
        var recpcon = '@HttpContextAccessor.HttpContext?.Session.GetString("GetRecpCon")';
        //debugger;
        if (recpcon != null || recpcon != "") {
            $("#QuicksmsorCampaign_CampaignNameorRecipient").val(recpcon);
        }

        window.onload = function () {
            setTimeout(function () {
                $("#QuicksmsorCampaign_CampaignNameorRecipient").focus();
                //debugger;
                var recpcon = '@HttpContextAccessor.HttpContext?.Session.GetString("GetRecpCon")';
                if (recpcon != "") {
                    if (confirm("@lz.Areyousureyouwanttoproceedwithselectednumbers")) {
                        $("#QuicksmsorCampaign_CampaignNameorRecipient").val(recpcon);
                    }
                    else {
                        $("#QuicksmsorCampaign_CampaignNameorRecipient").val("");
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("SessionContacts", "CampaignPlugin")',
                            headers: headers,
                            data: { RemoveRecp: "Remove" },
                            datatype: 'application/json',
                            success: function (d) {
                                if (d != (null || undefined)) {

                                }
                            },
                            error: function (xhr, error, status) {

                            }
                        });
                    }
                }
            }, 500);
            //var count = $("#QuicksmsorCampaign_SenderId option").length;
            //if (count == 2) {
            //    $("#QuicksmsorCampaign_SenderId option:first").hide();
            //    $("#QuicksmsorCampaign_SenderId").prop("selectedIndex", 1);
            //}
            $("#QuicksmsorCampaign_PreviewMessage").val($("#QuicksmsorCampaign_Message").val());
            $('.p-icon').removeAttr("data-target", "#msg-pre");
        }
        $('.show-btn').click(function (event) {
            $('#main-formarea').show();
            $("#ContactsMainDiv,#TemplateDiv").hide();
        });
        $('.p-icon').click(function (event) {
            //$("body, html").animate({
            //    scrollTop: $(document).height()
            //}, 200)
            if ($("#QuicksmsorCampaign_Message").val() == "") {
                $('.p-icon').removeAttr("data-target", "#msg-pre");
                $("#QuicksmsorCampaign_Message").parent().find(".error").remove();
                $("#QuicksmsorCampaign_Message").css("border", "1px solid red");
                $("#QuicksmsorCampaign_Message").parent().append('<div class="error" style="color: red; height:10px !important;">@lz.PleaseEnterMessage</div>');
            }
            else {
                $('.p-icon').attr("data-target", "#msg-pre");
            }
            $('#hide-msglist').slideToggle();
            //$(".close-btn span").toggleClass("icomoon-icon-close iconred");
        });
        $('.close-btn').click(function (event) {
            $('#hide-msglist').slideUp();
        });
        function CheckAllContacts(cntrl) {
            if ($(cntrl).is(":checked")) {
                $("#SelContactsDiv").find("[data-parent=C]").attr("checked", "checked");
                $("#SelContactsDiv").find("[data-parent=C]").prop("checked", "checked");
            }
            else {
                $("#SelContactsDiv").find("[data-parent=C]").removeAttr("checked", "checked");
                $("#SelContactsDiv").find("[data-parent=C]").removeProp("checked", "checked");
            }
        }
        function OnCheckTemplate(cntrl) {

            if ($(cntrl).is(":checked")) {
                $("#TemplateDiv").show();
                $("#QuicksmsorCampaign_Message").attr("disabled", true);
                var CampType = 1;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LoadTemplates", "CampaignPlugin")',
                    headers: headers,
                    data: { CampType: CampType },
                    datatype: 'application/json',
                    success: function (data) {
                        $('#QuicksmsorCampaign_TemplateID').html("");
                        $('#QuicksmsorCampaign_TemplateID').append($('<option></option>').val(0).html("--Select Templates--"));
                        $.each(data, function (key, val) {
                            $('#QuicksmsorCampaign_TemplateID').append(
                                $('<option></option>').val(val.ID + "$VMHDC$" + val.LANGUAGEID + "$VMHDC$" + val.TEXT).html(val.NAME));
                        });
                    },
                    error: function (xhr, status) {
                        errorMessage('@lz.ExceptionOccured');
                        $("html, body").animate({ scrollTop: 0 }, 600);
                    }
                });
            }
            else {
                $("#TemplateDiv").hide();
                $("#QuicksmsorCampaign_Message").attr("disabled", false);
                $("#QuicksmsorCampaign_Message").val("");
                $("#QuicksmsorCampaign_PreviewMessage").val("");
                $('.english').prop("checked", true);
                $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
                removeerrorstylectrolfocus("#QuicksmsorCampaign_TemplateID");
                fnShowCount();
            }
        }
        function OnChangeTemplate(cntrl) {
            var arabiclan = /[\u0621-\u064A]/;
            var TempLang = $('#QuicksmsorCampaign_TemplateID').val().split('$VMHDC$')[1];
            var TempText = $('#QuicksmsorCampaign_TemplateID').val().split('$VMHDC$')[2];
            $("#QuicksmsorCampaign_Message").val(TempText);
            removeerrorstylectrolfocus("#QuicksmsorCampaign_Message");
            $("#QuicksmsorCampaign_PreviewMessage").val(TempText);
            if (TempLang == 1) {
                $('.english').attr("checked", true);
                $('.english').prop("checked", true);
                $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'en');
            } else {
                $('.arabic').attr("checked", true);
                $('.arabic').prop("checked", true);
                var msgval = $('#QuicksmsorCampaign_Message').val();
                var msgvall = $('#QuicksmsorCampaign_PreviewMessage').val();
                if (msgval.match(arabiclan) || msgvall.match(arabiclan)) {
                    $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'rtl').attr('lang', 'ar');
                }
                else {
                    $('#QuicksmsorCampaign_Message,#QuicksmsorCampaign_PreviewMessage').focus().attr('dir', 'left').attr('lang', 'ar');
                }
            }
            fnShowCount();
        }


        var langchk = false;
        $("#btnSave").click(function (event) {
            
            // langUnicode()
            if ($("#QuicksmsorCampaign_SenderId option:selected").text() == "Any") {
                if ($("#QuicksmsorCampaign_AnySender").val().length == 0) {
                    $("#QuicksmsorCampaign_AnySender").attr("rc", "y");
                    $("#QuicksmsorCampaign_AnySender").focus();
                }
            }
            else {
                $("#QuicksmsorCampaign_AnySender").attr("rc", "n");
            }
            var ContactsCount = $("#QuicksmsorCampaign_CampaignNameorRecipient").val().split(',').length;            
            var MaxLmt = "@Configuration["MaxQSMSLimit"]";            
            if (parseInt(MaxLmt) < ContactsCount) {
                errorMessage("@lz.Pleaseenteronly " + MaxLmt + " @lz.RecipientS");
                $("html,body").animate({ scrollTop: 0 }, 600);
                return false;
            }
            IsunseenJunk();            
            var obj = $("#QuicksmsorCampaign_Message");
            // mostrar(obj);
            var regEx = />/g;
            var regExless = /</g;
            var sval = (obj.val().replace(regExless, "< ").replace(regEx, " >")); //.trim();
            //  obj.val(sval.replace(/\s\s+/g, ' '));
            if ($("#QuicksmsorCampaign_Template").is(":checked")) {
                $("#QuicksmsorCampaign_TemplateID").attr("rc", "y");
            }
            else {
                $("#QuicksmsorCampaign_TemplateID").attr("rc", "n");
            }
            var IsValid = validateAjaxclick('#ADDForm');            
            // msg = replaceAll("'nl'", "\r\n", msg);
            var Message = $("#QuicksmsorCampaign_Message").val().trim();
            if (Message.length <= 0) {
                $("#QuicksmsorCampaign_Message").parent().find(".error").remove();
                $("#QuicksmsorCampaign_Message").css("border", "1px solid red");
                $("#QuicksmsorCampaign_Message").parent().append('<div class="error" style="color: red; height:10px !important;">@lz.PleaseEnterMessage</div>');
                return false;
            }

            if (IsValid) {
                var message = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse($("#QuicksmsorCampaign_Message").val().replace(/’/g, "'")), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                // var message = $("#QuicksmsorCampaign_Message").val();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("IsUnicode")',
                    headers: headers,
                    data: { sms: message },
                    datatype: 'application/json',
                    success: function (d) {                        
                        langCrs = d;
                        langchk = d;

                        var conCode = @Configuration["CountryCode"]
                        //console.log(conCode);
                        if (conCode != (null || undefined) && conCode === 91) {
                            var mNos = $("#QuicksmsorCampaign_CampaignNameorRecipient").val().split(',');
                            for (var i = 0; i < mNos.length; i++) {
                                if (mNos[i].length == 10) {
                                    mNos[i] = mNos[i].replace(mNos[i], (conCode + mNos[i]));
                                }
                            }
                        }
                        removeerrorstylectrolfocus("#QuicksmsorCampaign_Message");
                        var QsmsStatus = true;
                        var QSMSID = $("#hdnQsmsID").val();
                        var MobileNos = conCode != (null || undefined) ? mNos.join(',') : $("#QuicksmsorCampaign_CampaignNameorRecipient").val();
                        var SenderID = $("#QuicksmsorCampaign_SenderId").val();
                        var SenderName = '';    //Added by murty
                        if ($("#QuicksmsorCampaign_SenderId option:selected").text() == "Any") {
                            SenderName = $("#QuicksmsorCampaign_AnySender").val();
                        }
                        else {
                            SenderName = $("#QuicksmsorCampaign_SenderId option:selected").text();
                        }
                        var CharCount = $("#txtCharCount").html();
                        var Credits = $("#txtMSgCount").html();
                        var LangID = nlangid;
                        if ($(".english").is(":checked") && langCrs == false) {
                            LangID = nlangid;
                            Language = "English";

                        }
                        if ($(".arabic").is(":checked") && langCrs == true) {
                            Language = "Arabic";
                            if (Language = "Arabic") {
                                nlangid = 2;
                            }
                            LangID = nlangid;
                        }
                        if ($(".english").is(":checked") && langCrs == true) {
                            if (confirm("@lz.Pleasechoosecorrectlanguage")) {
                                LangID = nlangid;
                                Language = "Arabic";
                                IsValid = false;
                                return false;
                            }
                            else {
                                IsValid = false;
                                return false;
                            }
                        } else if ($(".arabic").is(":checked") && langCrs == false) {
                            if (confirm("@lz.Pleasechoosecorrectlanguage")) {
                                LangID = nlangid;
                                Language = "English";
                                IsValid = false;
                                return false;

                            }
                            else {
                                IsValid = false;
                                return false;
                            }
                        }                        
                        var DLR = "";
                        if ($("#QuicksmsorCampaign_DeliveryReport").is(":checked")) { DLR = 1; }
                        else { DLR = 1; }
                        var spltmobnos = MobileNos.split(',');
                        var UniqNums = "";
                        var DupNums = "";
                        $.each(spltmobnos, function (i, item) {
                            var rgx = new RegExp("^[0-9,.]+$");
                            item = item.trim();
                            if (rgx.test(item)) {
                                if (item != "") {
                                    if (UniqNums.indexOf(item) == -1) {
                                        UniqNums += item + ",";
                                    }
                                    else { DupNums += item + ","; }
                                }
                            }
                            else {
                                QsmsStatus = false;
                                return false;
                            }
                        });
                        

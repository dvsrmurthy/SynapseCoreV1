        function isArabic(char) {
            var pattern = new RegExp(/[^\u0000-\u007F]/);
            return pattern.test(char);
        }

        function count(string) {
            var count = 0;
            for (var i = 0; i < string.length; i++) {
                if (isArabic(string.charAt(i))) {
                    count++;
                };
            };
            return count;
        }

        function splCount(sval) {
            var regex = /([€|{}\[\]\\~^])/g
            var allFoundCharacters = sval.match(regex);
            if (allFoundCharacters != null) {
                if (allFoundCharacters.length > 0) {
                    return allFoundCharacters.length * 1
                }
            } else {
                return 0;
            }
        }

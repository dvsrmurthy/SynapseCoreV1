@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <title>Synapse Messaging Platform</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="@Url.Content("~/IntroPagesContent/css/main.css")">
    <link rel="stylesheet" href="@Url.Content("~/IntroPagesContent/css/services.css")">
</head>
<body>
    <div>
        <header>
            <div class="logo">
                <a href="@Url.Action("About", "Home")">  <img src="@Url.Content("~/IntroPagesContent/images/synapselogo.svg")" alt=""> </a>
            </div>
            <nav class="desktop-nav">
                <a href="@Url.Action("About", "Home")">About company</a>
                <a href="@Url.Action("complaince", "Home")">Compliance</a>
                <a href="@Url.Action("services", "Home")">Services</a>
                <a href="@Url.Action("Contact", "Home")">Contact</a>
                <a class="sign-in-btn" href="@Url.Action("Login", "Account")">Sign in</a>
            </nav>
        </header>
        <main>
            <section class="channels">
                <h2>Unified engagement platform for wider reach and flexibility</h2>
                <div class="channels-container">
                    <div class="channel">
                        <i class="icon_vectra_sms"></i>
                        <span>SMS</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_email-open"></i>
                        <span>Email</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_whatsapp"></i>
                        <span>Whatsapp</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_chat-bot"></i>
                        <span>Chat Bot</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_messenger"></i>
                        <span>Messenger</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_rcs"></i>
                        <span>RCS</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_push-notifications"></i>
                        <span>Push<br>Notification</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_web-notifications"></i>
                        <span>Web<br>Notification</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_apple-messanger"></i>
                        <span>Apple<br>Messenger</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_instagram"></i>
                        <span>Instagram</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_viber"></i>
                        <span>Viber</span>
                    </div>
                    <div class="channel">
                        <i class="icon_vectra_wechat"></i>
                        <span>We Chat</span>
                    </div>
                </div>
            </section>



            <section class="happier-conversations">
                <h3> Because there’s a relationship in every<br> <span class="fw-bold">conversation.</span></h3>
                <div class="row align-items-center mt-60">
                    <div class="col-sm-6 text-start pe-5">
                        <span class="sub-heading">
                            Send <span class="sub-heading-big">10,000</span> messages per
                            second!
                        </span>
                        <p>
                            Engage with a wider audience in a flash! Synapse is built for high throughput endurance to meet the most
                            demanding needs of any enterprise. Its' robust output capabilities convert every conversation into a
                            token of happy experiences, resulting in endearing customer relationships.
                        </p>
                    </div>
                    <div class="col-sm-6">
                        <img src="@Url.Content("~/IntroPagesContent/images/fast_sms.svg")" class="img-fluid" alt="Instant delivery. Wider reach. Happier conversations.">
                    </div>
                </div>

                <div class="row align-items-center mt-104">
                    <div class="col-sm-6">
                        <img src="@Url.Content("~/IntroPagesContent/images/rocket-inphone.svg")" class="img-fluid" alt="Never miss an opportunity to engage">
                    </div>
                    <div class="col-sm-6 text-start pe-5">
                        <span class="sub-heading">Never miss an opportunity to engage</span>
                        <p>Integrate with your core system using our rich API suite that enables real time messaging.</p>
                    </div>
                </div>

                <div class="row align-items-center mt-104">
                    <div class="col-sm-6 text-start pe-5">
                        <span class="sub-heading">Schedule campaigns efficiently!</span>
                        <p>Schedule your campaign for future dates. Or even pause or reschedule them.</p>
                    </div>
                    <div class="col-sm-6">
                        <img src="@Url.Content("~/IntroPagesContent/images/appt-calendar-clock.svg")" class="img-fluid" alt="Instant delivery. Wider reach. Happier conversations.">
                    </div>
                </div>

                <div class="row align-items-center mt-104 pb-100">
                    <div class="col-sm-6">
                        <img src="@Url.Content("~/IntroPagesContent/images/credit-management.svg")" class="img-fluid" alt="Gain control with Credit Management!">
                    </div>
                    <div class="col-sm-6 text-start pe-5">
                        <span class="sub-heading">Gain control with Credit Management!</span>
                        <p>
                            Enjoy administrative control by allocating the desired number of credits to specific departments and
                            users.
                        </p>
                    </div>
                </div>


            </section>
        </main>
    </div>
</body>
</html>

    <script type="text/javascript">
        var Q = '@Configuration["ScKey"]';
        var key = CryptoJS.enc.Utf8.parse(Q);
        var iv = CryptoJS.enc.Utf8.parse(Q);
        $(window).on('resizeEnd', function () {
            if ($(window).width() >= 320 && $(window).width() <= 992) {
                $("#content-container, input").on("click focus", function () {
                    if ($('#container').hasClass("mainnav-lg") === true) {
                        $(".mainnav-toggle").trigger("click");
                    }
                });
            }
        });

        window.addEventListener("load", function (event) {
            if ($(window).width() >= 320 && $(window).width() <= 992) {
                $("#content-container, input").on("click focus", function () {
                    if ($('#container').hasClass("mainnav-lg") === true) {
                        $(".mainnav-toggle").trigger("click");
                    }
                });
            }
            $(document).ajaxStart(function () {
                $("#qLoverlay").css('background', 'rgba(187, 187, 187, 0.5)').fadeIn(700);
                $("#qLbar").fadeIn(700);
            });
            $(document).ajaxComplete(function () {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("ajaxSession", "Account", new { Area = string.Empty })',
                    data: { key_leave: "" },
                    global: false,
                    success: function (d) {
                        if (d != "") {
                            // location.reload();
                            location.href = "@Url.Action("LogOff", "Account", new { Area = string.Empty })";
                        }
                    }
                });
                $("#qLoverlay").fadeOut(700);
                $("#qLbar").fadeOut(700);
            });
            $(document).on("contextmenu", function (e) {
                if ($(e.target).is(".allowrc")) {
                    return true;
                }
                if ($(e.target).is(".form-control")) {
                    if ($(window).width() < 1024) {
                        return true;
                    } else {
                        return false;
                    }
                }
            });
            $('.form-controls').bind('drag drop', function (e) {
                e.preventDefault();
            });

            // Disable part of page
            $('.form-control').bind('drag drop', function (e) {
                e.preventDefault();
            });
            $('.form-control.allowrc').on("contextmenu", function (e) {
                return true;
            });
            if ($("#smscdash").val() != 1) {
                $('.smsclists').remove()
                $('.smsclists').hide()
            }
            //dashboard session
            var curPath = window.location.href;
            var rDir = curPath.search("/Account/Log");
            if ($('input[type=hidden]#csttype').length < 1 && rDir == -1) {
                setTimeout(function () {
                    location.href = "@Url.Action("LogOff", "Account", new { Area = string.Empty })";
                }, 300);
            }
        });

        window.close = function () {            
            $.ajax({
                type: 'POST',
                url: '@Url.Action("LogOff", "Account", new { Area = string.Empty })',
                async: false,
                data: { key_leave: "" }
            });
        }
        $('.boxed > .text-danger').parent().addClass('errorpage');
        var baseurl = "@Url.Content("~/")";
        var synlogo = "Content/images/logo.svg";
        var clilogo = "~/Content/images/client-logo.png";
        $('.errorpage').append('<p class=""><a class="btn  btn-info " href="@Url.Action("Login", "Account", new { Area = string.Empty })"> Login</a></p>');        
        $('.errorpage > h1').html('<p><img style="margin:0 auto;" src="' + baseurl + '/' + synlogo + '" width="150px" /></p>');
        $('.errorpagetwo > h1').html('<p><img style="margin:0 auto;" src="' + baseurl + '/' + synlogo + '" width="150px" /></p>');
        $('.errorpage > h2').html('<i class="fa fa-clock-o"></i> @(HttpContextAccessor.HttpContext.Session.GetString("internalmessage") == null ? "Your session has been expired." : HttpContextAccessor.HttpContext.Session.GetString("internalmessage"))');

        var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
        var headers = {};
        headers['__RequestVerificationToken'] = antiForgeryToken;


        function clng(l) {
            if (l != '') {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LChange", "Account")',
                    headers: headers,
                    data: { lng: l },
                    datatype: 'application/json',
                    success: function (d) {
                        location.reload(false);
                    },
                    error: function (xhr, error, status) {
                        console.log(xhr);
                    }
                });
            }
        }


        function langSelection(lang) {
            if (lang != '') {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("LChange", "Account", new { Area = string.Empty })',
                    headers: headers,
                    data: { lng: lang },
                    datatype: 'application/json',
                    success: function (d) {
                        location.reload(false);
                    },
                    error: function (xhr, error, status) {
                        console.log(xhr);
                    }
                });
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<body body class="@lngClass">
    @if (u != null && (User.Identity.IsAuthenticated))
    {
        
        <script>
                var Q = '@Configuration["ScKey"]';
                var key = CryptoJS.enc.Utf8.parse(Q);
                var iv = CryptoJS.enc.Utf8.parse(Q);
            function updateCredits() {
                var CustomerId = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse('@u.CustomerId'), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var CreditType = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse('@u.CreditType'), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                var RoleId = CryptoJS.AES.encrypt(CryptoJS.enc.Utf8.parse('@u.RoleId'), key, { keySize: 128 / 8, iv: iv, mode: CryptoJS.mode.CBC, padding: CryptoJS.pad.Pkcs7 }).toString();
                $.ajax({
                    type: 'Post',
                    url: '@Url.Action("GetCredits", "Account", new { Area = string.Empty })',
                    data: { cid: CustomerId, cttyp: CreditType, rid: RoleId },
                    global: false,
                    success: function (d) {
                        if (d == "ADMIN") {
                        }
                        if (d == "UNLIMITED") {
                            $('.availCredits').html('UNLIMITED');
                        } else {
                            $('.availCredits').html(d);
                        }

                    }
                });
            }
            updateCredits();
        </script>
    }

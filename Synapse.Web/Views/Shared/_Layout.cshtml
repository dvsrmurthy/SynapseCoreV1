@using Core.Models.Dtos.CommonDtos
@using Core.Models.Extensions
@using Synapse.Web.Helpers.SecureAccess
@using Synapse.Web.Models
@using Synapse.Web.Helpers
@inject IConfiguration Configuration;
@inject IHttpContextAccessor HttpContextAccessor;

@{
    var lz = SessionExtensions.GetItem<LocalizationResponse>(HttpContextAccessor.HttpContext.Session);
    var MenuItems = HttpContextAccessor.HttpContext.Session.GetItem<List<MenuItem>>();
    var synlogo = "~/css/images/logo.svg";
    var clilogo = "~/css/images/client-logo.png";
    dynamic u = null;
    dynamic extendedUser = null;
    var ln = HttpContextAccessor.HttpContext.Session.GetString("ln") == null ? "en" : HttpContextAccessor.HttpContext.Session.GetString("ln");
    var lngClass = ln == "en" ? "lnEnglish" : "lngArbic";
    var lngdir = ln == "en" ? "ltr" : "rtl";
    var IsAuth = User.Identity.IsAuthenticated;
    var pTitle = string.Empty;
    if (User.Identity.IsAuthenticated)
    {
        extendedUser = SessionExtensions.GetItem<Core.Models.Extensions.CustomeUser>(HttpContextAccessor.HttpContext.Session);
        if (@ViewBag.verifymessage == "Failed" || @ViewBag.Message == "1")
        {
            extendedUser = null;
        }
        if (extendedUser != null)
        {
            u = extendedUser.LogOnRespons;
            var pitems = new List<SubMenuItems>();
            if (MenuItems != null)
            {
                foreach (var it in MenuItems)
                {
                    pitems.AddRange(it.ChildMenuItems);
                }
                var pgtitle = pitems.FirstOrDefault(f => f.Name.Equals(ViewBag.Title, StringComparison.OrdinalIgnoreCase));
                if (pgtitle != null)
                {
                    pTitle = ln == "en" ? pgtitle.Name : pgtitle.ArabicName;
                }
            }
        }
    }
}

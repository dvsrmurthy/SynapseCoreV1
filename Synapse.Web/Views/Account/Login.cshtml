        var timeoutHandle;
        function countdown(minutes) {           
            var seconds = 60;
            var mins = minutes
            function tick() {
                var counter = document.getElementById("TimeLabelId");                
                var current_minutes = mins - 1
                seconds--;
                counter.innerHTML =
                    current_minutes.toString() + "m" + ":" + (seconds < 10 ? "0" : "") + String(seconds) + "s";
                if (seconds > 0) {
                    timeoutHandle = setTimeout(tick, 1000);
                } else {
                    if (mins > 1) {
                        setTimeout(function () { countdown(mins - 1); }, 1000);
                    }
                    else {
                        $("#otpcheck").hide();
                        $("#secoundgrid").show();
                        $(".both").attr('disabled', false);
                        $(".mobile").attr('disabled', false);
                        $(".email").attr('disabled', false);
                        $(".both").attr('checked', false);
                        $(".mobile").attr('checked', false);
                        $(".email").attr('checked', false);
                        $("#Melabelonload").show();
                        $("#Melabel").hide();
                        $("#verifyBtn").attr('disabled', false);
                    }
                }
            }
            tick();
        }


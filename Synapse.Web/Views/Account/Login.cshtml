@using Core.Models.Dtos.CommonDtos
@using Synapse.Web.Helpers.SecureAccess
@using Synapse.Web.Models
@inject IConfiguration Configuration;
@inject IHttpContextAccessor HttpContextAccessor;

@model LoginViewModel
@{
    ViewBag.Title = "Log in";
    var Lan = HttpContextAccessor.HttpContext.Session.GetItem<AppLocalization>() ?? new AppLocalization { Language = "en" };
    var data = @ViewBag.Message == null ? "0" : @ViewBag.Message;
    var isIpWhitelistScreen = @ViewBag.isIpWhitelistScreen == null ? "0" : @ViewBag.isIpWhitelistScreen;

    var d = @ViewBag.verifymessage == "Failed" ? (data = "3") : "";

    var sendmobile = @ViewBag.Mobile;
    var sendemail = @ViewBag.Email;
    var ppword = @ViewBag.Pword;
    //var senderid = @ViewBag.SenderId;
    //var sendername = @ViewBag.SenderName;
    var mess = @ViewBag.otpmessage;
    var captch = @ViewBag.Captch;
    //var ran = @ViewBag.randomno;
    var rvalue = @ViewBag.RandValue;
    var ran = HttpContextAccessor.HttpContext.Session.GetString("OTPCode");
    var otime = @ViewBag.OTPTime;
    string loggedUsername = HttpContextAccessor.HttpContext.Session.GetString("abc");
    var OTPSCREEN = @ViewBag.Qresult;
    int noofTimes = HttpContextAccessor.HttpContext.Session.GetInt32("nooftimes") != null ? Convert.ToInt32(HttpContextAccessor.HttpContext.Session.GetInt32("nooftimes")) : 0;
    string errorList = string.Empty;
    if (!ViewData.ModelState.IsValid)
    {
        var errors = ViewData.ModelState.Values
                           .SelectMany(v => v.Errors)
                           .Select(e => e.ErrorMessage)
                           .ToList();
        foreach (var error in errors)
        {
            errorList = errorList + "</br>";
        }

    }
}
<div class="cls-content" style="z-index: 5; max-height: 600px; display: flex; align-items: center; @(data != "10" && isIpWhitelistScreen == "0" ? "display:block" : "display:none")" id="login">
    <div class="cls-content-sm panel">
        <div class="panel-body">
            <div class="mar-ver pad-btm">
                <p class="text-center"><a href="@Url.Action("Index", "Home")"><img id="logoimgs" class="imglogin" src="~/Content/images/logo.svg" /></a></p>
                <h3 class="h4 mar-no text-center login-ct"><span>Account Login</span> </h3>
            </div>
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form-horizontal", onsubmit = "validateTagInput()", @autocomplete = "off", @onload = "RefreshcaptchaLogin()" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div style="@(data == "0" ? "display:block" : "display:none")" id="firstgrid">
                    <div class="form-group">                        
                        <div class="col-md-12">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @autocomplete = "off", @placeholder = "Username", @maxlength = "25" })
                            <span class="icon16 icomoon-icon-user right gray marginR10"></span>                            
                        </div>
                    </div>
                    <div class="form-group">                        
                        <div class="col-md-12">
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Password", @autocomplete = "off", @maxlength = "25" })
                            <span class="icon16 icomoon-icon-lock right gray marginR10"></span>
                            @Html.HiddenFor(m => m.ActionVerificationId)
                            @Html.HiddenFor(m => m.VerifiedToken)                           
                        </div>
                    </div>
                    <div class="form-group" oncopy="return false" onpaste="return false">
                        <div class="col-md-6">
                            @Html.TextBoxFor(x => x.loginCaptcha, new { @class = "form-control", @autocomplete = "off", @placeholder = "Enter Captcha", @ct = "text", @rc = "y", Maxlength = "6", Minlength = "6", @errormsg = "Please Enter Captcha", @onclick = "removeerrorstylectrolfocus(this)", @onchange = "removeerrorstylectrolfocus(this)", @onkeypress = "return blockSpecialChar(event,this)" })
                        </div>
                        <div class="col-md-6">
                            <span id="capidLogin" style="font-weight:bold;font-style:italic;background:url('../Content/images/capchabg.png') no-repeat;padding: 6px 0;text-align: center;font-size: 15px;width: 95px;margin-left: 2px;">@ViewBag.LoginCaptcha</span>&nbsp;
                            <button type="button" onclick="RefreshcaptchaLogin()" class="btn btn-default glyphicon glyphicon-refresh" />
                        </div>
                    </div>
                    <input type="hidden" name="forgotForm" value="0" />
                    
                    <div class="form-group">
                        <div class="col-md-12">
                            <input type="checkbox" id="chkTerms" />&nbsp; I Agree <a href="@Url.Content("~/IntroPagesContent/pdf/terms_conditions.pdf")" style="text-decoration:underline;color:blue" target="_blank">terms and conditions.</a>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-12">
                            <label id="lblInvalid" style="color:red;display:none;"></label>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-lg-12 clearfix form-actions">
                            <button type="submit" onclick="OnLoginClick()" class="btn btn-info right btn-block" id="loginBtn"><span class="icon16 icomoon-icon-enter white"></span> Login</button>
                        </div>
                    </div>


                    <div class="form-group">
                        <div class="col-lg-12 clearfix form-actions">
                            <a id="lnkForgotPassword" href="javascript:void(0);" style="text-decoration:underline">Forgot My Password</a>
                        </div>
                        @{
                            var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors);
                        }
                        @foreach (var item in errors)
                        {
                            if (item.ErrorMessage.Contains("Please whitelist your IP"))
                            {
                                <div class="col-lg-12 clearfix form-actions">
                                    <a id="lnkIPWhitelist" href="#" style="text-decoration:underline">IP Whitelist</a>
                                </div>
                            }
                        }
                        <div><span style="color:red" id="viewbagmsg">&nbsp;@ViewBag.msg</span></div>
                    </div>
                    @Html.HiddenFor(s => s.forgotForm, new { @Value = "0" })
                    @if (Configuration["onPremise"] == "true" || Configuration["onPremise"] == "")
                    {
                        <div style="float:left;padding-left:5px;" class="client-logoimg"><img src="../Content/images/et-logo.png" style="display: none" onload="this.style.display=''" /></div>
                        <div style="float:right; padding-right:5px;" class="client-logoimg"><img src="../Content/images/synapse-logo.png" /></div>
                    }                    
                </div>

                <div style="@(data == "1" ? "display:block" : "display:none")" id="secoundgrid">
                    <div class="form-group">

                        <div class="form-group" style="color:white">
                            @Html.LabelFor(x => x.Labelname, new { id = "LabelId" })
                        </div>
                        <div class="col-md-12">
                            <h5><b>Select any one of the options to receive OTP</b></h5>
                        </div>
                        <div class="col-md-12">
                            @*@Html.CheckBoxFor(x => x.MNumberEmailID, true)  <span style="margin-top: -6px;">Mobile Number & EmailID</span>*@
                            @Html.RadioButtonFor(x => x.radiocheck, "1", new { @type = "radio", @ct = "radio", @class = "both", @onclick = "removeerrorstylectrolfocus(this)", @onchange = "lngchk(this),getmobemail()" }) Mobile Number & EmailID
                        </div>
                        @*<div class="col-md-12">
                                @Html.TextBoxFor(x => x.mobile, new { @class = "form-control", @autocomplete = "off" })
                            </div>*@
                    </div>

                    <div class="form-group">
                        <div class="col-md-12">
                            @*@Html.CheckBoxFor(x => x.MNumber, true)  <span style="margin-top: -6px;">Mobile Number</span>*@
                            @Html.RadioButtonFor(x => x.radiocheck, "2", new { @type = "radio", @ct = "radio", @class = "mobile", @onclick = "removeerrorstylectrolfocus(this)", @onchange = "lngchk(this),getmobemail(this)" }) Mobile Number
                        </div>
                        @*<div class="col-md-12">
                                @Html.TextBoxFor(x => x.eemail, new { @class = "form-control", @autocomplete = "off" })
                            </div>*@
                    </div>

                    <div class="form-group">
                        <div class="col-md-12">
                            @*@Html.CheckBoxFor(x => x.EmailID, true)  <span style="margin-top: -6px;">EmailID</span>*@
                            @Html.RadioButtonFor(x => x.radiocheck, "3", new { @type = "radio", @ct = "radio", @class = "email", @onclick = "removeerrorstylectrolfocus(this)", @onchange = "lngchk(this),getmobemail(this)" }) EmailID
                        </div>
                        @*<div class="col-md-12">
                                @Html.TextBoxFor(x => x.eemail, new { @class = "form-control", @autocomplete = "off" })
                            </div>*@
                    </div>

                    <div class="form-group" style="display:none" id="Melabelonload">
                        <div class="col-md-12">
                            @Html.LabelFor(x => x.Mename, new { id = "Melabel" })
                        </div>
                    </div>


                    <div class="form-group">
                        <div class="col-lg-12 clearfix form-actions">
                            <button type="button" onclick="Sendotp(1)" class="btn btn-info right btn-block" id="Sendid"><span class="icon16 icomoon-icon-enter white"></span> Send OTP</button>

                            @*<button type="button" name="command" id="Sendotp" class="btn btn-primary btn-sm pad-ho text-semibold" value="Save">Send</button>*@
                        </div>
                    </div>


                </div>

                <div style="@(data == "3" ? "display:block" : "display:none")" id="otpcheck">
                    <div class="add-field" id="ADDForm">
                        <div class="form-group">
                            <div class="col-md-12">
                                @Html.LabelFor(x => x.sixdigits, new { id = "sixdigitslabel" })
                            </div>
                        </div>
                        <div class="form-group">
                            <div class="col-md-6">
                                @Html.TextBoxFor(x => x.Otp, new { @class = "form-control", @ct = "text", @rc = "y", @placeholder = "Enter OTP", Maxlength = "6", @autocomplete = "off", Minlength = "6", @errormsg = "Please Enter OTP", @onclick = "removeerrorstylectrolfocus(this)", @onchange = "removeerrorstylectrolfocus(this)", @onkeypress = "return isNumberKey(event)" })
                            </div>
                            <div class="col-md-6">
                                <span id="timeid" style="text-align:center;color:#58b4ca;font-weight:bold;display:block;margin-bottom:6px">Time left <span id="TimeLabelId">@ViewBag.OTPTime + 'm' + ':' + '00s'</span></span>
                            </div>
                        </div>

                        <div class="form-group" oncopy="return false" onpaste="return false">
                            <div class="col-md-6">
                                @Html.TextBoxFor(x => x.randomcapt, new { @class = "form-control", @autocomplete = "off", @placeholder = "Enter Captcha", @ct = "text", @rc = "y", Maxlength = "6", Minlength = "6", @errormsg = "Please Enter Captcha", @onclick = "removeerrorstylectrolfocus(this)", @onchange = "removeerrorstylectrolfocus(this)", @onkeypress = "return blockSpecialChar(event,this)" })
                            </div>
                            <div class="col-md-6">
                                <span id="capid" style="font-weight:bold;font-style:italic;background:url('../Content/images/capchabg.png') no-repeat;padding: 6px 0;text-align: center;font-size: 15px;width: 95px;margin-left: 2px;">@ViewBag.Captch</span>&nbsp;
                                <button type="button" onclick="Refreshcaptcha()" class="btn btn-default glyphicon glyphicon-refresh" />
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="col-md-6 clearfix form-actions">
                                <button type="submit" class="btn btn-info right btn-block" id="verifyBtn"><span class="icon16 icomoon-icon-enter white"></span> Verify</button>
                            </div>
                            <div class="col-md-6 clearfix form-actions">
                                <button type="button" onclick="Sendotp(2)" class="btn btn-info right btn-block" id="Resendid"><span class="icon16 icomoon-icon-enter white"></span> Resend OTP</button>
                                @*<button type="submit" onclick="Verify()" class="btn btn-info right btn-lg btn-block" id=""><span class="icon16 icomoon-icon-enter white"></span> Verify</button>*@
                            </div>
                        </div>
                    </div>
                </div>
                <div style="visibility:hidden">
                    <input type="hidden" name="Kvl" id="Kvl" value="@(Configuration["ScKey"])" />                    
                    <input type="hidden" name="LoginCaptchaValue" value="0" class="form-control" />
                </div>

            }
        </div>
    </div>
</div>




<div class="cls-content" style="z-index:5; max-height: 600px; display:flex; align-items:center;@(data == "10" && isIpWhitelistScreen == "0" ? "display:block" : "display:none")"
     id="loginForgot">
    <div class="cls-content-sm panel">
        <div class="panel-body">
            <div class="mar-ver pad-btm">
                <p class="text-center"><a href="@Url.Action("Index", "Home")"><img id="logoimgs" class="imglogin" src="~/Content/images/logo.svg" /></a></p>
                <h3 class="h4 mar-no text-center login-ct"><span>Forgot Password</span> </h3>
            </div>
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form-horizontal", onsubmit = "validateTagInput()", @autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    <div class="col-md-12">
                        User Name
                        @Html.TextBoxFor(m => m.forgotPasswordUsername, new { @class = "form-control", @autocomplete = "off", @placeholder = "Username", @maxlength = "25" })
                        <span class="icon16 icomoon-icon-user right gray marginR10" style="color:red" id="forgotpasswordusererror"></span>
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-12">
                        Registered E-Mail
                        @Html.TextBoxFor(m => m.forgotPasswordEmail, new { @class = "form-control", @autocomplete = "off", @placeholder = "Registered Email", @maxlength = "100" })
                        <span class="icon16 icomoon-icon-user right gray marginR10" style="color:red" id="forgotpasswordusererror"></span>
                    </div>
                </div>
                <div class="form-group" oncopy="return false" onpaste="return false">
                    <div class="col-md-6">
                        @Html.TextBoxFor(x => x.forgotPasswordrandomcapt, new { @class = "form-control", @autocomplete = "off", @placeholder = "Enter Captcha", @ct = "text", @rc = "y", Maxlength = "6", Minlength = "6", @errormsg = "Please Enter Captcha", @onclick = "removeerrorstylectrolfocus(this)", @onchange = "removeerrorstylectrolfocus(this)", @onkeypress = "return blockSpecialChar(event,this)" })
                    </div>
                    <div class="col-md-6">
                        <span id="capidforgotpassword" style="font-weight:bold;font-style:italic;background:url('../Content/images/capchabg.png') no-repeat;padding: 6px 0;text-align: center;font-size: 15px;width: 95px;margin-left: 2px;">@ViewBag.Captch</span>&nbsp;
                        <button type="button" onclick="RefreshcaptchaForgotPassword()" class="btn btn-default glyphicon glyphicon-refresh" />
                        <span class="icon16 icomoon-icon-user right gray marginR10" style="color:red" id="forgotpasswordinvalidCatcha"></span>
                    </div>
                </div>
                <div class="form-group">&nbsp;</div>
                <div class="form-group">
                    <div class="col-lg-12 clearfix form-actions">
                        <button type="submit" class="btn btn-info right btn-block" id="forgotPasswordStep1Validate"><span class="icon16 icomoon-icon-enter white"></span>Reset Password</button>
                    </div>
                </div>
                <div style="visibility:hidden">
                    @Html.HiddenFor(x => x.Hidlabel, new { id = "Kvl", @Value = (Configuration["ScKey"]) })
                    @Html.HiddenFor(x => x.ForgotPasswordCaptchaValue, new { id = "ForgotPasswordCaptchaValue", @Value = "0", @class = "form-control" })
                </div>
                @Html.HiddenFor(s => s.forgotForm, new { @Value = "1" })
                <div class="form-group">
                    @if (Model != null)
                    {
                        if (Model.forgotReturnMessage != null)
                        {
                            if (Model.forgotReturnMessage.Contains("Invalid") || Model.forgotReturnMessage.Contains("contact admin"))
                            {
                                <span style="color: red;" id="forgotError" class="col-lg-12 clearfix form-actions">@Html.Raw(Model.forgotReturnMessage)</span>
                            }
                            else
                            {
                                <span style="color: #0dcaf0;" id="forgotError" class="col-lg-12 clearfix form-actions">@Html.Raw(Model.forgotReturnMessage)</span>
                            }
                        }
                    }
                    else
                    {
                        <span style="color: #0dcaf0;" id="forgotError" class="col-lg-12 clearfix form-actions"></span>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="cls-content" style="z-index:5; max-height: 600px; display:flex; align-items:center;@(data == "100" ? "display:block" : "display:none")"
     id="ipWhiteList">
    <div class="cls-content-sm panel">
        <div class="panel-body">
            <div class="mar-ver pad-btm">
                <p class="text-center"><a href="@Url.Action("Index", "Home")"><img id="logoimgs" class="imglogin" src="~/Content/images/logo.svg" /></a></p>
                <h3 class="h4 mar-no text-center login-ct"><span>IP Whitelist</span> </h3>
            </div>
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "form-horizontal", onsubmit = "validateTagInput()", @autocomplete = "off", @onload = "RefreshcaptchaIpWhiteList()" }))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="form-group">
                    <div class="col-md-12">
                        User Name
                        @Html.TextBoxFor(m => m.ipwhitelistUserName, new { @class = "form-control", @autocomplete = "off", @placeholder = "Username", @maxlength = "25", @readonly = "true", @Value = @ViewBag.Uname })
                        <span class="icon16 icomoon-icon-user right gray marginR10" style="color:red" id="ipwhitelistusererror"></span>
                    </div>
                </div>
                <div class="form-group" oncopy="return false" onpaste="return false" style="@(OTPSCREEN == "OTPSCREEN" ? "display:block" : "display:none")">
                    <div class="col-md-6">
                        @Html.TextBoxFor(x => x.ipwhitelistRandomcapt, new
                        {
                            @class = "form-control",
                                        @autocomplete = "off",
                                        @placeholder = "Enter Captcha",
                                        @ct = "text",
                                        @rc = "y",
                                        Maxlength = "6",
                                        Minlength = "6",
                                        @errormsg = "Please Enter Captcha",
                                        @onclick = "removeerrorstylectrolfocus(this)",
                                        @onchange = "removeerrorstylectrolfocus(this)",
                                        @onkeypress = "return blockSpecialChar(event,this)"
                                        })
                </div>
                <div class="col-md-6">
                    <span id="ipwhitelistMobile" style="font-weight:bold;font-style:italic;background:url('../Content/images/capchabg.png') no-repeat;padding: 6px 0;text-align: center;font-size: 15px;width: 95px;margin-left: 2px;">@ViewBag.Captch</span>&nbsp;
                    <button type="button" onclick="RefreshcaptchaIpWhiteList()" class="btn btn-default glyphicon glyphicon-refresh" />
                    <span class="icon16 icomoon-icon-user right gray marginR10" style="color:red" id="ipwhitelistedvalidCapcha"></span>
                </div>
            </div>
            <div id="divIpWhitelistMobileOtp">
                <div class="form-group" style="@(OTPSCREEN == null ? "display:block" : "display:none")">
                    <span style="color:red">An OTP will be send to your registered mobile number.@ViewBag.MobileNo to whitelist your IP </span>
                    <button id="btnIpWhitelistOTPSCREEN" class="btn btn-warning">Do you want to send the otp?</button>
                </div>
                <div style="@(OTPSCREEN == "OTPSCREEN" ? "display:block" : "display:none")">
                    <div class="form-group">
                        <span style="color:red">OTP sent to your registered mobile number.@ViewBag.MobileNo </span>
                    </div>
                    <div class="form-group" oncopy="return false" onpaste="return false" style="@(isIpWhitelistScreen == "1" ? "display:block" : "display:none")">
                        <div class="col-md-6">
                            Mobile OTP
                            @Html.TextBoxFor(x => x.ipwhitelistMobileOTP, new
                                                        {
                                    @class = "form-control",
                                                        @autocomplete = "off",
                                                        @placeholder = "OTP",
                                                        @ct = "text",
                                                        @rc = "y",
                                                        Maxlength = "6",
                                                        Minlength = "6",
                                                        @errormsg = "Please Enter OTP",
                                                        @onclick = "removeerrorstylectrolfocus(this)",
                                                        @onchange = "removeerrorstylectrolfocus(this)",
                                                        @onkeypress = "return isNumberKey(event)"
                                                        })
                        </div>
                        <div class="col-md-6" style="padding-top:18px;">
                            @if (noofTimes > 1)
                                {
                                    <button type="button" class="btn btn-info" id="resendWhiteListOtp">
                                        <span class="icon16 icomoon-icon-enter white"></span>Resend OTP
                                    </button>
                                }
                                else
                                {

                                    <button type="button" class="btn btn-info" id="resendWhiteListOtp" onclick="return whitelistIPOTPResend()">
                                        <span class="icon16 icomoon-icon-enter white"></span>Resend OTP
                                    </button>
                                }
                            </div>
                        </div>
                        @*<div class="col-md-6">
                                <span id="timeidWhitelistIp" style="text-align:center;color:#58b4ca;font-weight:bold;display:block;margin-bottom:6px">Time left <span id="TimeLabelId2">@ViewBag.OTPTime + 'm' + ':' + '00s'</span></span>
                            </div>*@
                    </div>
                    <div class="form-group" style="@(OTPSCREEN == "OTPSCREEN" ? "display:block" : "display:none")">
                        <div class="col-lg-12 clearfix form-actions">
                            <button type="submit" class="btn btn-info right btn-block" id="ipwhitelistStep1Validate">
                                <span class="icon16 icomoon-icon-enter white"></span>Whitelist My IP
                            </button>
                        </div>
                        <div><span style="color:red">&nbsp;@ViewBag.msg</span></div>
                    </div>
                    @Html.HiddenFor(i => i.forgotForm, new { @Value = "2" })
                    <div style="visibility:hidden">
                        @Html.HiddenFor(x => x.Hidlabel, new { id = "Kvl", @Value = (Configuration["ScKey"]) })
                        @Html.HiddenFor(x => x.WhiteListIPCaptchaValue, new { id = "WhiteListIPCaptchaValue", @Value = "0", @class = "form-control" })
                    </div>
                    <span style="color: red;" id="ipWhitelistError"></span>
                </div>
            }
        </div>
    </div>
</div>



<input type="hidden" id="hdnLang" value="" />
<input type="hidden" id="emailotp" value="" />
<input type="hidden" id="forgotCapcha" value="" />
<input type="hidden" id="time" value="" />
@section Scripts {
    <script type="text/javascript">
        var antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();
        var headers = {};
        headers['__RequestVerificationToken'] = antiForgeryToken;

        $("#btnIpWhitelistOTPSCREEN").on('click', function () {
            if (confirm("Are you sure you want to send otp to registered mobile no?")) {
                return true;
            } else {
                return false;
            }
        });

            $("#lnkIPWhitelist").on('click', function () {               
                RefreshcaptchaIpWhiteList();
                $("#ipWhiteList").css('display', 'block');
                $("#ipwhitelistMobile").css('display', 'block')
                $("#login").css('display', 'none');
            });

            $("#lnkForgotPassword").on('click', function () {
                $('.validation-summary-errors').remove();
                RefreshcaptchaForgotPassword();
                $("#forgotPasswordUsername").val('');
                $("#forgotPasswordrandomcapt").val('');
                $("#loginForgot").css('display', 'block');
                $("#login").css('display', 'none');
            });

            $("#ipwhitelistStep1Validate").on('click', function (event) {
                if ($("#ipwhitelistUserName").val().length == 0) {
                    $("#ipWhitelistError").html("Invalid Username !!");
                    alert("Invalid Username !!");
                    $("#ipwhitelistUserName").focus();
                    return false;
                }
                else if ($("#ipwhitelistRandomcapt").val().length == 0) {
                    $("#ipWhitelistError").html("Invalid Captcha !!");
                    alert("Invalid Captcha !!");
                    $("#ipwhitelistRandomcapt").focus();
                    return false;
                }
                else if ($("#ipwhitelistMobileOTP").val().length == 0) {

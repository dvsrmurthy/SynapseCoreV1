        //Analytics
        function analyticsChr(dobj) {
            getMap(dobj);
        }

        function getMap(arr) {
            $("#maparea").html('');
            if (arr.length > 0) {
                new Morris.Area({
                    // ID of the element in which to draw the chart.
                    element: 'maparea',
                    width: '100%',
                    // Chart data records -- each entry in this array corresponds to a point on
                    // the chart.
                    data: arr,
                    // The name of the data record attribute that contains x-values.
                    xkey: 'y',
                    // A list of names of data record attributes that contain y-values.
                    ykeys: ['a'],
                    parseTime: false,
                    lineColors: ["#0078D8", "#00BCD4", "#BA68C8", "#FFA726"],
                    // Labels for the ykeys -- will be displayed when you hover over the
                    // chart.
                    labels: ['SMS'],
                    hideHover: 'auto',
                    pointSize: 0,
                    lineWidth: 0,
                    resize: true
                });
            } else {
                $("#maparea").html('<br><br><br><div class="text-center col-sm-6 col-sm-offset-3">@lz.NoDataFound</div>');
            }
            if ($("#maparea svg circle").length === 1) {
                $("#maparea svg circle").attr('r', 8);
            }
        }

        function getMoChart(arr, minutes) {
            $("#MoChartArea").html('');
            if (arr.length > 0) {
                new Morris.Area({
                    // ID of the element in which to draw the chart.
                    element: 'MoChartArea',
                    width: '100%',
                    // Chart data records -- each entry in this array corresponds to a point on
                    // the chart.
                    data: arr,
                    // The name of the data record attribute that contains x-values.
                    xkey: 'y',
                    // A list of names of data record attributes that contain y-values.
                    ykeys: ['a'],
                    parseTime: false,
                    lineColors: ["#0078D8", "#00BCD4", "#BA68C8", "#FFA726"],
                    labels: ['SMS'],
                    hideHover: 'auto',
                    pointSize: 0,
                    lineWidth: 0,
                    resize: true
                });
            }
            else {
                $("#MoChartArea").html('<br><br><br><div class="alert alert-sm text-center col-sm-6 col-sm-offset-3">No Data Found</div>');
            }
            if ($("#MoChartArea svg circle").length === 1) {
                $("#MoChartArea svg circle").attr('r', 8);
            }
            var stabl = $('#minuteWisetbl');
            stabl.html('');
            var minData;
            $.each(minutes, function (i, item) {
                minData += "<tr><td>Last " + item.LastMinute + " minutes :</td><td>" + item.mCount + "</td></tr>";
            });
            stabl.append(minData);
        }

        function successratio(SRation) {
            document.getElementById("successratio").innerHTML = SRation.Average + '%';
        }

        function throughputc(arr) {
            if (arr != (null || undefined)) {
                $("#tppersecond").html(parseFloat(Math.round(arr.avg() * 100) / 100).toFixed(2) + ' SMS/Sec');
            }
        }

        function moduletraffic(mtraffic) {
            var smstotal = numberWithThousands((mtraffic.Camp + mtraffic.Qsms + mtraffic.Alerts));
            $("#smscount").html(smstotal);
        }

        function pullsms(arr) {
            if (arr != (null || undefined)) {
                $("#ProcessTime").html(arr + ' sec');
            }
        }

        function msToTime(duration) {
            var milliseconds = parseInt((duration % 1000) / 100)
                , seconds = parseInt((duration / 1000) % 60)
                , minutes = parseInt((duration / (1000 * 60)) % 60)
                , hours = parseInt((duration / (1000 * 60 * 60)) % 24);

            hours = (hours < 10) ? "0" + hours : hours;
            minutes = (minutes < 10) ? "0" + minutes : minutes;
            seconds = (seconds < 10) ? "0" + seconds : seconds;

            return seconds + "." + milliseconds;
        }



        function campactivity(arr) {
            $("#tblcampactivity tbody").html('');
            var tablerow = '';

            if (arr != (null || undefined) && arr.length > 0) {
                for (var i = 0; i < arr.length; i++) {
                    tablerow += addrowcampactivity(arr[i]);
                }
            }

            $("#tblcampactivity tbody").html(tablerow);
            $("#tblcampactivity").hide();
            setTimeout(function () {
                $("#tblcampactivity").show();
                var CampTable = $('#tblcampactivity');
                var lgval = document.getElementById("hdnLang").value == "lngArbic" ? "بحث" : "Search:";
                var slenghmenu = (document.getElementById("hdnLang").value == "lngArbic" ? ("تبين" + " _MENU_ " + "إدخالات") : "Show _MENU_ entries");
                var sinfo = (document.getElementById("hdnLang").value == "lngArbic" ? ("عرض" + " _START_ " + " إلى " + " _END_ " + " من " + " _TOTAL_ " + "إدخالات") : "Showing _START_ to _END_ of _TOTAL_ entries");
                var nodatamsg = document.getElementById("hdnLang").value == "lngArbic" ? "لا تتوفر بيانات في الجدول" : "No data available in table";
                var nomatchmsg = document.getElementById("hdnLang").value == "lngArbic" ? "لم يتم العثور على سجلات مطابقة" : "No matching records found";
                var sInfoFiltertext = document.getElementById("hdnLang").value == "lngArbic" ? "(تمت تصفيتها من _MAX_ إجمالي الإدخالات)" : "(filtered from _MAX_ total entries)";
                var sInfoempt = document.getElementById("hdnLang").value == "lngArbic" ? "عرض 0 إلى 0 من 0 إدخالات" : "Showing 0 to 0 of 0 entries";
                CampTable.dataTable({
                    "destroy": true,
                    "language": {
                        "search": lgval,
                        "sLengthMenu": slenghmenu,
                        "emptyTable": nodatamsg,
                        "sZeroRecords": nomatchmsg,
                        "sInfoFiltered": sInfoFiltertext,
                        "sInfoEmpty": sInfoempt,
                        "sInfo": sinfo,
                        "paginate": {
                            "previous": '<i class="demo-psi-arrow-left"></i>',
                            "next": '<i class="demo-psi-arrow-right"></i>'
                        }
                    },
                });
                $('.dataTables_filter input, .dataTables_length select').addClass('form-control');
                $('#tblcampactivity_paginate .pagination .paginate_button.active').trigger('click');
            }, 2000);
        }

        function addrowcampactivity(row) {
            var tablerow = '';
            tablerow += '<tr>';
            tablerow += '<td>' + row.CampName + '</td>';
            tablerow += '<td>' + row.UserName + '</td>';
            tablerow += '<td><span class="text-muted"><i class="fa fa-clock-o"></i>' + row.ScheduleDate + '</span></td>';
            tablerow += '<td>' + row.CampaignType + '</td>';
            tablerow += '<td>';
            tablerow += '<div class="label label-table label-' + row.Progress +'">' + row.Progress + '</div>';
            tablerow += '</td>';
            tablerow += '</tr>';
            return tablerow;
        }

        function smstable(arr) {
            $("#tblsmsc tbody").html('');
            var tablerow = '';
            setTimeout(function () {
                if (arr != (null || undefined) && arr.length > 0) {
                    tablerow = '';
                    for (var i = 0; i < arr.length; i++) {
                        tablerow += addrowsms(arr[i]);
                    }
                }
                $("#tblsmsc tbody").html(tablerow);
                var SMSCtable = $('#tblsmsc');

                $('#tblsmsc').dataTable();
                $('.dataTables_filter input, .dataTables_length select').addClass('form-control');
                $('#tblsmsc_paginate .pagination .paginate_button.active').trigger('click');
            }, 2000);

        }

        function addrowsms(row) {
            var tablerow = '';
            tablerow += '<tr>';
            tablerow += '<td>' + row.SmscName + '</td>';
            tablerow += '<td>';
            if (row.Status != (null || undefined) && row.Status == 'Active') {
                tablerow += '<div class="label label-table label-success">' + row.Status + '</div>';
            } else {
                tablerow += '<div class="label label-table label-danger">' + row.Status + '</div>';
            }
            tablerow += '</td>';
            tablerow += '<td>' + row.Tps + '</td>';
            if (row.Action == 'Bind') {
                tablerow += '<td> Bound</td>';
            }
            else {
                tablerow += '<td> Unbind</td>';
            }
            if (row.Status != (null || undefined) && row.Status == 'Active') {//row.Id
                var value = "'" + row.Id + "','0'";
                var value1 = "'" + row.Id + "','1'";
                tablerow += '<td><a href="#" onclick="updatesms(' + value + ')" class="btn btn-info btn-xs editform-btn">Unbind</a> <a href="#" onclick="updatesms(' + value1 + ')" class="btn btn-info btn-xs editform-btn">Bind</a> </td>';
            } else {
                tablerow += '<td><a href="#" onclick="updatesms(' + value + ')" class="btn btn-info btn-xs editform-btn disabled">Unbind</a> <a href="#" onclick="updatesms(' + value1 + ')" class="btn btn-info btn-xs editform-btn disabled">Bind</a> </td>';
            }
            tablerow += '</tr>';
            return tablerow;
        }

        function updatesms(id, b) {
            confirm('Are you sure you want to change the Bind status !');
            $.ajax({
                type: "POST",
                url: '@Url.Action("BindOrUnbind", "Home")',
                headers: headers,
                data: { Id: id, bound: b },
                datatype: 'application/json',
                success: function (d) {
                    if (d) {
                        emsg("@lz.UpdatedSuccessfully", false);
                        location.reload(false);
                    }
                },
                error: function (xhr, error, status) {
                    console.log(error);
                    console.log(xhr.errorMessage);
                }
            });
        }

            function GetShortcode() {
                $('#Shortcodes').multiselect('rebuild');
                setTimeout(function () {
                    $('#Shortcodes').next().find('button').removeClass('btn-default').addClass('btn-primary').css('border-radius', '5px');
                    $('.shr-btn').css({ 'position': 'relative', 'z-index': '99' });
                }, 900);
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetShortcodeByUsers", "Home")",
                headers: headers,
                data: { id: '@XUser.LogOnRespons.Id' },
                datatype: 'application/json',
                success: function (d) {
                    if (d.length > 0) {
                        $("#Shortcodes").empty().append('<option value="All">All</option>');
                        $.each(d, function (i, item) {
                            $('#Shortcodes').append($('<option>', {
                                value: item.Id,
                                text: item.Shortcode
                            }));
                        });
                    }
                    $('#Shortcodes').multiselect('rebuild');
                    setTimeout(function () {
                    $('#Shortcodes').next().find('button').removeClass('btn-default').addClass('btn-primary').css('border-radius','5px');
                    $('.shr-btn').css({ 'position': 'relative', 'z-index': '99' });
                    }, 900);
                },
                error: function (xhr, error, status) {
                    var e = xhr;
                }
            });

        }
    </script>
}
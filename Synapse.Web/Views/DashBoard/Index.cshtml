@using Synapse.Web.Helpers.SecureAccess
@using Synapse.Web.Models
@using Core.Models.Dtos.CommonDtos
@inject IConfiguration Configuration;
@inject IHttpContextAccessor HttpContextAccessor;

@{
    ViewBag.Title = "Dash Board";
    var lz = SessionExtensions.GetItem<LocalizationResponse>(HttpContextAccessor.HttpContext.Session);
    Layout = "~/Views/Shared/_Layout.cshtml";
    dynamic u = null;
    if (User.Identity.IsAuthenticated)
    {
        var extendedUser = SessionExtensions.GetItem<CustomeUser>(HttpContextAccessor.HttpContext.Session);
        if (extendedUser != null)
        {
            u = extendedUser.LogOnRespons;
        }
    }
    var XUser = SessionExtensions.GetItem<Core.Models.Extensions.CustomeUser>(HttpContextAccessor.HttpContext.Session);
    var IsXUserRole = 0;
    if (Configuration["IndianSynapse"] == "true")
    {
        if (XUser != null && XUser.LogOnRespons != null && XUser.LogOnRespons.CustomerType == 1)
        {
            IsXUserRole = XUser.LogOnRespons.CustomerType;
        }
    }
    else
    {
        if (XUser != null && XUser.LogOnRespons != null && XUser.LogOnRespons.Id == 1)
        {
            IsXUserRole = XUser.LogOnRespons.Id;
        }
    }
    var Dtype = HttpContextAccessor.HttpContext.Session.GetItem<Core.Models.Extensions.GlobalUsageProperties>() ?? new Core.Models.Extensions.GlobalUsageProperties();
    var Utype = 0;
    if (Dtype != null)
    {
        Utype = Dtype.UserType;
    }
    Html.AntiForgeryToken();
    var controller = HttpContextAccessor.HttpContext.GetRouteValue("controller")?.ToString();
    string layout = "";

    if (u != null && !u.RoleName.Equals("SynAdmin"))
    {
        @Html.PartialAsync("_DashBoard")
        ;
    }
    else
    {
        @await Html.PartialAsync("_AdminDashBoard")
    }

}
@section scripts {

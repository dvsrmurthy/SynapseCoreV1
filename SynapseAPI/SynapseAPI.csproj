<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <EnableSdkContainerDebugging>True</EnableSdkContainerDebugging>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:8.0</ContainerBaseImage>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\FHIRManager\**" />
    <Compile Remove="Controllers\HL7Manager\**" />
    <Compile Remove="Controllers\HMS\**" />
    <Compile Remove="Controllers\MailManager\**" />
    <Content Remove="Controllers\FHIRManager\**" />
    <Content Remove="Controllers\HL7Manager\**" />
    <Content Remove="Controllers\HMS\**" />
    <Content Remove="Controllers\MailManager\**" />
    <EmbeddedResource Remove="Controllers\FHIRManager\**" />
    <EmbeddedResource Remove="Controllers\HL7Manager\**" />
    <EmbeddedResource Remove="Controllers\HMS\**" />
    <EmbeddedResource Remove="Controllers\MailManager\**" />
    <None Remove="Controllers\FHIRManager\**" />
    <None Remove="Controllers\HL7Manager\**" />
    <None Remove="Controllers\HMS\**" />
    <None Remove="Controllers\MailManager\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Results\ChallengeResult.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext" Version="9.7.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.7.0" />
    <PackageReference Include="Microsoft.AspNet.Identity.EntityFramework" Version="2.2.4" />
    <PackageReference Include="Microsoft.AspNet.Identity.Owin" Version="2.2.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="Swashbuckle" Version="5.6.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.9" />
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Data\Core.Data.csproj" />
    <ProjectReference Include="..\Core.Models\Core.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\Account\" />
    <Folder Include="Results\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="web.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
